<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bidding.controller.MainController"
            stylesheets="@../css/style.css"
            styleClass="root">

    <left>
        <VBox styleClass="sidebar" prefWidth="220" spacing="10">
            <padding>
                <Insets top="30" right="10" bottom="20" left="10"/>
            </padding>

            <!-- ĐÃ CẬP NHẬT: Thêm nhãn số dư và nút nạp tiền -->
            <VBox alignment="CENTER" spacing="5">
                <Label text="🏆 BidVault" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Xin chào," style="-fx-text-fill: #bdc3c7; -fx-font-size: 12px;"/>
                <Label fx:id="lblUsername" text="User" style="-fx-text-fill: #2ecc71; -fx-font-weight: bold;"/>
                <Label fx:id="balanceLabel" text="Số dư: 0 ₫" style="-fx-text-fill: #f1c40f; -fx-font-weight: bold; -fx-font-size: 14px;" />
                <!-- Nút nạp tiền nhỏ gọn dưới tên User -->
                <Button text="💳 Nạp tiền" onAction="#handleOpenDeposit"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 11px; -fx-background-radius: 15; -fx-cursor: hand;">
                    <VBox.margin><Insets top="5"/></VBox.margin>
                </Button>

                <VBox.margin><Insets bottom="20"/></VBox.margin>
            </VBox>

            <Button fx:id="btnDashboard" text="🏛 Sảnh Đấu Giá" onAction="#handleDashboard" styleClass="menu-button" maxWidth="Infinity"/>
            <Button fx:id="btnInventory" text="📦 Kho Đồ &amp; Đăng Bán" onAction="#handleInventory" styleClass="menu-button" maxWidth="Infinity"/>
            <Button fx:id="btnHistory" text="📋 Lịch Sử Đặt Giá" onAction="#handleHistory" styleClass="menu-button" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Button text="🚪 Đăng Xuất" onAction="#handleLogout" styleClass="logout-button" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #f4f6f9;">
        </StackPane>
    </center>
</BorderPane>