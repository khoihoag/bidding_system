<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bidding.controller.BidHistoryController"
            styleClass="main-root"
            prefWidth="1200" prefHeight="750">

    <top>
        <HBox styleClass="content-header" alignment="CENTER_LEFT" spacing="16">
            <Button text="← Quay lại"
                    onAction="#handleBack"
                    styleClass="secondary-button"/>
            <VBox spacing="2">
                <Label text="Lịch Sử Đấu Giá Của Tôi"
                       styleClass="page-title"/>
                <Label fx:id="subtitleLabel"
                       text="Toàn bộ các lượt đặt giá của bạn"
                       styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🔄 Làm mới"
                    onAction="#handleRefresh"
                    styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <VBox styleClass="content-area" spacing="16">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <HBox spacing="16">

                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="4">
                    <Label fx:id="totalBidsStatLabel"
                           text="0"
                           styleClass="stat-number"/>
                    <Label text="Tổng lượt đặt"
                           styleClass="stat-desc"/>
                </VBox>

                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="4">
                    <Label fx:id="acceptedBidsStatLabel"
                           text="0"
                           styleClass="stat-number stat-number-success"/>
                    <Label text="Được chấp nhận"
                           styleClass="stat-desc"/>
                </VBox>

                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="4">
                    <Label fx:id="rejectedBidsStatLabel"
                           text="0"
                           styleClass="stat-number stat-number-danger"/>
                    <Label text="Bị từ chối"
                           styleClass="stat-desc"/>
                </VBox>

                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="4">
                    <Label fx:id="highestBidStatLabel"
                           text="0 ₫"
                           styleClass="stat-number stat-number-accent"/>
                    <Label text="Lượt đặt cao nhất"
                           styleClass="stat-desc"/>
                </VBox>

            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Lọc theo trạng thái:" styleClass="field-label"/>
                <ComboBox fx:id="statusFilterCombo"
                          promptText="Tất cả"
                          onAction="#handleFilterChange"
                          styleClass="input-field"
                          prefWidth="180"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="recordCountLabel"
                       text=""
                       styleClass="hint-label"/>
            </HBox>

            <TableView fx:id="historyTable"
                       VBox.vgrow="ALWAYS"
                       styleClass="history-table">

                <columns>

                    <TableColumn fx:id="colIndex"
                                 text="#"
                                 prefWidth="50"
                                 resizable="false"
                                 sortable="false"/>

                    <TableColumn fx:id="colAuctionId"
                                 text="Mã Phiên Đấu Giá"
                                 prefWidth="200"/>

                    <TableColumn fx:id="colBidAmount"
                                 text="Số Tiền Đặt (₫)"
                                 prefWidth="180"/>

                    <TableColumn fx:id="colBidTime"
                                 text="Thời Gian Đặt"
                                 prefWidth="180"/>

                    <TableColumn fx:id="colBidType"
                                 text="Loại"
                                 prefWidth="130"/>

                    <TableColumn fx:id="colStatus"
                                 text="Trạng Thái"
                                 prefWidth="150"/>

                </columns>

            </TableView>

            <Label fx:id="statusLabel"
                   text=""
                   styleClass="hint-label"
                   alignment="CENTER"/>

        </VBox>
    </center>

</BorderPane>