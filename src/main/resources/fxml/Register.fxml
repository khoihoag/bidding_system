<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.bidding.controller.RegisterController"
           styleClass="root-pane"
           stylesheets="@../css/style.css">

    <VBox alignment="CENTER" maxWidth="420" maxHeight="650" styleClass="login-card" StackPane.alignment="CENTER">

        <VBox alignment="CENTER" spacing="6">
            <Label text="🏆 BidVault" styleClass="app-title"/>
            <Label text="Đăng ký tài khoản mới" styleClass="app-subtitle"/>
            <VBox.margin>
                <Insets bottom="20"/>
            </VBox.margin>
        </VBox>

        <VBox spacing="12" maxWidth="340">
            <VBox spacing="4">
                <Label text="Tên đăng nhập (*)"/>
                <TextField fx:id="usernameField" promptText="Nhập tên đăng nhập..."/>
            </VBox>

            <VBox spacing="4">
                <Label text="Họ và Tên (*)"/>
                <TextField fx:id="fullNameField" promptText="Nhập họ và tên thực..."/>
            </VBox>

            <VBox spacing="4">
                <Label text="Email (*)"/>
                <TextField fx:id="emailField" promptText="Nhập địa chỉ email..."/>
            </VBox>

            <VBox spacing="4">
                <Label text="Mật khẩu (*)"/>
                <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu..."/>
            </VBox>

            <VBox spacing="4">
                <Label text="Xác nhận mật khẩu (*)"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Nhập lại mật khẩu..."/>
            </VBox>

            <Label fx:id="errorLabel" text="Lỗi..." textFill="#e74c3c" visible="false" wrapText="true"/>

            <Button fx:id="registerButton" text="Đăng Ký" maxWidth="1.7976931348623157E308" onAction="#handleRegister" styleClass="action-button">
                <VBox.margin>
                    <Insets top="10"/>
                </VBox.margin>
            </Button>

            <HBox alignment="CENTER" spacing="5">
                <Label text="Đã có tài khoản?"/>
                <Hyperlink text="Đăng nhập ngay" onAction="#handleBackToLogin"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>