<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.bidding.controller.LoginController"
           styleClass="root-pane"
           stylesheets="@../css/style.css">

    <VBox alignment="CENTER" maxWidth="420" maxHeight="520"
          styleClass="login-card"
          StackPane.alignment="CENTER">

        <!-- Logo / Tiêu đề -->
        <VBox alignment="CENTER" spacing="6">
            <Label text="🏆 BidVault" styleClass="app-title"/>
            <Label text="Hệ thống đấu giá trực tuyến" styleClass="app-subtitle"/>
        </VBox>

        <VBox.margin>
            <Insets bottom="32"/>
        </VBox.margin>

        <!-- Form -->
        <VBox spacing="16" maxWidth="340">

            <VBox spacing="6">
                <Label text="Tên đăng nhập" styleClass="field-label"/>
                <TextField fx:id="usernameField"
                           promptText="Nhập tên đăng nhập..."
                           styleClass="input-field"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Mật khẩu" styleClass="field-label"/>
                <PasswordField fx:id="passwordField"
                               promptText="Nhập mật khẩu..."
                               styleClass="input-field"/>
            </VBox>

            <Label fx:id="errorLabel"
                   text=""
                   styleClass="error-label"
                   wrapText="true"/>

            <Button fx:id="loginButton"
                    text="Đăng Nhập"
                    onAction="#handleLogin"
                    maxWidth="Infinity"
                    styleClass="primary-button"/>

            <HBox alignment="CENTER" spacing="6">
                <Label text="Chưa có tài khoản?" styleClass="hint-label"/>
                <Hyperlink text="Đăng ký ngay"
                           onAction="#handleGoToRegister"
                           styleClass="link-text"/>
            </HBox>

        </VBox>

    </VBox>

</StackPane>
