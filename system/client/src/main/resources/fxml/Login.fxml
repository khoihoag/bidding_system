<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.bidding.controller.LoginController"
           styleClass="root-pane"
           stylesheets="@../css/style.css">

    <VBox alignment="CENTER" maxWidth="400" maxHeight="500"
          style="-fx-background-color: #FFFFFF;"
          StackPane.alignment="CENTER">

        <VBox alignment="CENTER" spacing="10">
            <Label text="BidVault." style="-fx-font-family: 'Georgia', 'Times New Roman', serif; -fx-font-size: 42px; -fx-text-fill: #111111;"/>
            <Label text="Private Auctions" style="-fx-font-size: 14px; -fx-text-fill: #6B7280; -fx-letter-spacing: 2px; -fx-text-transform: uppercase;"/>
        </VBox>

        <VBox.margin>
            <Insets bottom="40"/>
        </VBox.margin>

        <VBox spacing="20" maxWidth="320">

            <VBox spacing="8">
                <Label text="Tên đăng nhập" styleClass="field-label" style="-fx-font-weight: bold;"/>
                <TextField fx:id="usernameField"
                           promptText="Nhập tên đăng nhập..."
                           styleClass="input-field"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Mật khẩu" styleClass="field-label" style="-fx-font-weight: bold;"/>
                <PasswordField fx:id="passwordField"
                               promptText="Nhập mật khẩu..."
                               styleClass="input-field"/>
            </VBox>

            <Label fx:id="errorLabel"
                   text=""
                   textFill="#D10000"
                   wrapText="true"
                   style="-fx-font-size: 12px;"/>

            <Button fx:id="loginButton"
                    text="ĐĂNG NHẬP"
                    onAction="#handleLogin"
                    maxWidth="Infinity"
                    styleClass="primary-button"
                    style="-fx-padding: 12; -fx-letter-spacing: 1.5px;"/>

            <HBox alignment="CENTER" spacing="8" style="-fx-padding: 15 0 0 0;">
                <Label text="Chưa có tài khoản?" styleClass="hint-label"/>
                <Hyperlink text="Đăng ký ngay"
                           onAction="#handleGoToRegister"
                           style="-fx-text-fill: #111111; -fx-font-weight: bold; -fx-underline: true; -fx-border-width: 0;"/>
            </HBox>

        </VBox>
    </VBox>
</StackPane>