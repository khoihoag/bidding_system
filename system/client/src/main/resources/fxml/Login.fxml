<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.bidding.controller.LoginController"
           styleClass="login-background"
           stylesheets="@../css/style.css">

    <Pane mouseTransparent="true" opacity="0.55">
        <Line startX="795" startY="22" endX="1038" endY="262" stroke="#cfd6df"/>
        <Line startX="1038" startY="262" endX="1288" endY="62" stroke="#cfd6df"/>
        <Line startX="1038" startY="262" endX="1190" endY="344" stroke="#cfd6df"/>
        <Line startX="898" startY="86" endX="1288" endY="62" stroke="#cfd6df"/>
        <Line startX="1288" startY="62" endX="1365" endY="162" stroke="#cfd6df"/>
        <Circle centerX="795" centerY="22" radius="4" fill="#cfd6df"/>
        <Circle centerX="1038" centerY="262" radius="4" fill="#cfd6df"/>
        <Circle centerX="1288" centerY="62" radius="4" fill="#cfd6df"/>
        <Circle centerX="1190" centerY="344" radius="4" fill="#cfd6df"/>

        <Line startX="0" startY="424" endX="190" endY="680" stroke="#cfd6df"/>
        <Line startX="190" startY="424" endX="336" endY="508" stroke="#cfd6df"/>
        <Line startX="0" startY="584" endX="336" endY="508" stroke="#cfd6df"/>
        <Line startX="336" startY="508" endX="454" endY="680" stroke="#cfd6df"/>
        <Line startX="454" startY="680" endX="596" endY="712" stroke="#cfd6df"/>
        <Circle centerX="190" centerY="424" radius="4" fill="#cfd6df"/>
        <Circle centerX="336" centerY="508" radius="4" fill="#cfd6df"/>
        <Circle centerX="454" centerY="680" radius="4" fill="#cfd6df"/>
        <Circle centerX="596" centerY="712" radius="4" fill="#cfd6df"/>
    </Pane>

    <VBox alignment="CENTER"
          spacing="14"
          id="loginCard"
          minWidth="370"
          minHeight="475"
          prefWidth="370"
          prefHeight="475"
          maxWidth="370"
          maxHeight="475"
          styleClass="login-card"
          StackPane.alignment="CENTER">
        <Label text="🏆" style="-fx-font-size: 54px; -fx-text-fill: #d2aa2a;"/>

        <VBox alignment="CENTER" spacing="6">
            <Label text="BidVault" styleClass="brand-title-large"/>
            <Label text="Hệ thống đấu giá trực tuyến" styleClass="hint-label" style="-fx-font-size: 14px;"/>
        </VBox>

        <VBox spacing="14" maxWidth="305" style="-fx-padding: 10 0 0 0;">
            <VBox spacing="6">
                <Label text="Tên đăng nhập" styleClass="field-label"/>
                <TextField fx:id="usernameField"
                           promptText="Nhập tên đăng nhập..."
                           styleClass="input-field"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Mật khẩu" styleClass="field-label"/>
                <PasswordField fx:id="passwordField"
                               promptText="Nhập mật khẩu..."
                               styleClass="input-field"/>
            </VBox>

            <Label fx:id="errorLabel"
                   text=""
                   textFill="#b91c1c"
                   wrapText="true"
                   style="-fx-font-size: 12px;"/>

            <Button fx:id="loginButton"
                    text="Đăng Nhập"
                    onAction="#handleLogin"
                    maxWidth="Infinity"
                    styleClass="primary-button"/>

            <HBox alignment="CENTER" spacing="4" style="-fx-padding: 8 0 0 0;">
                <Label text="Chưa có tài khoản?" styleClass="hint-label"/>
                <Hyperlink text="Đăng ký ngay"
                           onAction="#handleGoToRegister"
                           style="-fx-text-fill: #075985; -fx-font-weight: 600; -fx-border-width: 0;"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
