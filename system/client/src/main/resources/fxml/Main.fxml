<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bidding.controller.MainController"
            stylesheets="@../css/style.css"
            styleClass="root">

    <top>
        <VBox style="-fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="40" style="-fx-padding: 15 40;">

                <Label text="BidVault." style="-fx-font-family: 'Georgia', 'Times New Roman', serif; -fx-font-size: 32px; -fx-text-fill: #111111;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER" spacing="35">
                    <Button fx:id="btnDashboard" text="SẢNH ĐẤU GIÁ" onAction="#handleDashboard" styleClass="top-nav-btn"/>
                    <Button fx:id="btnInventory" text="KHO ĐỒ &amp; ĐĂNG BÁN" onAction="#handleInventory" styleClass="top-nav-btn"/>
                    <Button fx:id="btnHistory" text="LỊCH SỬ ĐẶT GIÁ" onAction="#handleHistory" styleClass="top-nav-btn"/>
                    <Button text="THÔNG BÁO" onAction="#handleViewNotificationDetail" styleClass="top-nav-btn"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT" spacing="5">
                    <HBox alignment="CENTER_RIGHT" spacing="5">
                        <Label text="Xin chào," style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
                        <Label fx:id="lblUsername" text="User" style="-fx-font-size: 13px; -fx-text-fill: #111111; -fx-font-weight: bold;"/>
                    </HBox>
                    <HBox alignment="CENTER_RIGHT" spacing="15">
                        <Label fx:id="balanceLabel" text="0 đ" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111111;"/>
                        <Button text="Nạp tiền" onAction="#handleOpenDeposit" styleClass="secondary-button" style="-fx-padding: 4 10; -fx-font-size: 11px;"/>
                    </HBox>
                    <Button text="Đăng xuất" onAction="#handleLogout" styleClass="logout-btn"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #FFFFFF;">
        </StackPane>
    </center>

</BorderPane>