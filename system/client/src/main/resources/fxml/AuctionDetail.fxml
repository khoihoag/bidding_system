<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bidding.controller.AuctionDetailController"
            stylesheets="@../css/style.css"
            styleClass="content-surface"
            prefWidth="1200"
            prefHeight="750">

    <center>
        <StackPane>

            <ScrollPane fx:id="showcaseView" fitToWidth="true" hbarPolicy="NEVER" styleClass="content-surface">
                <VBox spacing="24" styleClass="auction-detail-page">
                    <HBox alignment="CENTER_LEFT" spacing="20" styleClass="auction-detail-action-header">
                        <VBox spacing="8">
                            <Button text="← Quay lại" onAction="#handleBack" styleClass="auction-detail-back-button"/>
                            <Label text="Trang chủ  ›  Sảnh đấu giá  ›  Chi tiết phiên" styleClass="auction-detail-breadcrumb"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="auction-detail-status-wrap">
                            <Label fx:id="statusBadgeHeader" text="ĐANG DIỄN RA" styleClass="auction-detail-status-badge"/>
                            <Label fx:id="headerAuctionId" text="ID: ..." styleClass="auction-detail-id-label"/>
                        </HBox>
                    </HBox>

                    <HBox spacing="24" alignment="TOP_LEFT">
                        <VBox spacing="18" HBox.hgrow="ALWAYS" styleClass="auction-detail-media-column">
                            <VBox spacing="16" styleClass="auction-detail-image-card">
                                <StackPane styleClass="auction-detail-image-frame">
                                    <ImageView fx:id="showcaseImageView" fitWidth="620" fitHeight="465" preserveRatio="true" smooth="true"/>
                                </StackPane>
                                <HBox spacing="12">
                                    <StackPane styleClass="auction-detail-thumb-active">
                                        <Label text="1" styleClass="auction-detail-thumb-label"/>
                                    </StackPane>
                                    <StackPane styleClass="auction-detail-thumb-muted">
                                        <Label text="+" styleClass="auction-detail-thumb-label"/>
                                    </StackPane>
                                </HBox>
                            </VBox>
                        </VBox>

                        <VBox spacing="20" minWidth="430" prefWidth="500" maxWidth="540">
                            <VBox spacing="18" styleClass="auction-detail-info-card">
                                <Label fx:id="showcaseNameLabel" wrapText="true" text="Đang tải..." styleClass="auction-detail-title"/>

                                <HBox alignment="CENTER_LEFT" spacing="24" styleClass="auction-detail-price-row">
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="Giá thầu hiện tại" styleClass="auction-detail-caption"/>
                                        <Label fx:id="showcasePriceLabel" text="0 ₫" styleClass="auction-detail-price"/>
                                    </VBox>
                                    <VBox spacing="6" alignment="CENTER_RIGHT">
                                        <Label text="Thời gian còn lại" styleClass="auction-detail-caption"/>
                                        <Label fx:id="showcaseTimeLabel" text="--:--:--" styleClass="auction-detail-time"/>
                                    </VBox>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="14">
                                    <StackPane styleClass="auction-detail-user-dot">
                                        <Label text="👤" style="-fx-font-size: 16px;"/>
                                    </StackPane>
                                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                                        <Label text="Người dẫn đầu" styleClass="auction-detail-caption"/>
                                        <Label fx:id="showcaseWinnerLabel" text="---" styleClass="auction-detail-winner"/>
                                    </VBox>
                                </HBox>

                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <Button text="Đấu giá" onAction="#handleEnterTradingRoom" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="auction-detail-bid-button"/>
                                    <Button fx:id="btnFollow" text="♡ Theo dõi" onAction="#handleFollowAuction" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="auction-detail-follow-button"/>
                                </HBox>
                            </VBox>

                            <VBox spacing="10" styleClass="auction-detail-info-card">
                                <Label text="Mô tả phiên đấu giá" styleClass="auction-detail-card-heading"/>
                                <Label fx:id="showcaseDescLabel" wrapText="true" styleClass="auction-detail-description"/>
                            </VBox>

                            <VBox spacing="10" styleClass="auction-detail-info-card">
                                <Label text="Thông số chi tiết" styleClass="auction-detail-card-heading"/>
                                <VBox fx:id="showcaseSpecsBox" spacing="8" styleClass="auction-detail-specs"/>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>
            </ScrollPane>


            <SplitPane fx:id="tradingRoomView" dividerPositions="0.35" visible="false" managed="false" style="-fx-background-color: #FFFFFF; -fx-padding: 20;">

                <ScrollPane fitToWidth="true" style="-fx-background-color: #FFFFFF; -fx-background: #FFFFFF; -fx-border-color: transparent;">
                    <VBox spacing="20" style="-fx-padding: 10 30 30 10; -fx-background-color: #FFFFFF;">

                        <VBox spacing="15" style="-fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-padding: 25; -fx-background-color: #F9FAFB;">
                            <Label text="THÔNG TIN PHIÊN" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #111111;"/>
                            <Label fx:id="itemNameLabel" text="Đang tải..." wrapText="true" style="-fx-font-family: 'Georgia', serif; -fx-font-size: 22px; -fx-text-fill: #111111;"/>

                            <VBox spacing="15">

                                <VBox spacing="5">
                                    <Label text="Giá hiện hành" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                                    <Label fx:id="currentPriceLabel" text="0 ₫" wrapText="true" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111111;"/>
                                </VBox>

                                <VBox spacing="5">
                                    <Label text="Thời gian còn lại" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                                    <Label fx:id="timeRemainingLabel" text="--:--:--" wrapText="true" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #D10000;"/>
                                </VBox>

                            </VBox>

                            <Separator style="-fx-background-color: transparent; -fx-border-color: #E5E7EB; -fx-border-width: 1 0 0 0;"/>

                            <HBox spacing="20">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Người dẫn đầu" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                                    <Label fx:id="currentWinnerLabel" text="---" style="-fx-font-weight: bold; -fx-text-fill: #111111;"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS" alignment="TOP_RIGHT">
                                    <Label text="Tổng lượt đặt" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                                    <Label fx:id="totalBidsLabel" text="0" style="-fx-font-weight: bold; -fx-text-fill: #111111;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox spacing="15" style="-fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-padding: 25; -fx-background-color: #FFFFFF;">
                            <Label text="ĐẶT GIÁ THỦ CÔNG" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #111111;"/>
                            <TextField fx:id="bidAmountField" promptText="Nhập mức giá của bạn (₫)..." style="-fx-padding: 12; -fx-border-color: #D1D5DB; -fx-background-color: #FFFFFF; -fx-text-fill: #111111;"/>
                            <Button fx:id="bidButton" text="XÁC NHẬN ĐẶT GIÁ" onAction="#handleBid" maxWidth="Infinity" style="-fx-background-color: #111111; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-padding: 14; -fx-cursor: hand; -fx-font-size: 13px;"/>
                            <Label fx:id="bidErrorLabel" text="" style="-fx-text-fill: #D10000; -fx-font-size: 12px;" wrapText="true"/>
                        </VBox>

                        <VBox fx:id="autoBidContainer" spacing="15" style="-fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-padding: 25; -fx-background-color: #FFFFFF;">
                            <Label text="AUTO-BID (TỰ ĐỘNG)" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #111111;"/>
                            <TextField fx:id="maxBidField" promptText="Giá tối đa bạn chấp nhận (₫)..." style="-fx-padding: 12; -fx-border-color: #D1D5DB; -fx-background-color: #FFFFFF; -fx-text-fill: #111111;"/>
                            <TextField fx:id="incrementField" promptText="Bước nhảy giá (₫)..." style="-fx-padding: 12; -fx-border-color: #D1D5DB; -fx-background-color: #FFFFFF; -fx-text-fill: #111111;"/>
                            <Button fx:id="autoBidButton" text="KÍCH HOẠT AUTO-BID" onAction="#handleAutoBid" maxWidth="Infinity" style="-fx-background-color: #FFFFFF; -fx-text-fill: #111111; -fx-border-color: #111111; -fx-border-width: 1; -fx-font-weight: bold; -fx-padding: 14; -fx-cursor: hand; -fx-font-size: 13px;"/>
                            <Label fx:id="autoBidErrorLabel" text="" style="-fx-text-fill: #D10000; -fx-font-size: 12px;" wrapText="true"/>
                        </VBox>

                        <Label fx:id="resultLabel" text="" alignment="CENTER" maxWidth="Infinity" style="-fx-font-weight: bold; -fx-text-fill: #111111;"/>
                    </VBox>
                </ScrollPane>

                <VBox spacing="15" style="-fx-padding: 10 20 30 20; -fx-background-color: #FFFFFF;">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="BIỂU ĐỒ GIÁ REALTIME" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #111111;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lastUpdateLabel" text="" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                    </HBox>
                    <LineChart fx:id="priceChart" VBox.vgrow="ALWAYS" animated="false" createSymbols="true" legendVisible="false" style="-fx-background-color: transparent;">
                        <xAxis>
                            <CategoryAxis fx:id="timeAxis" side="BOTTOM" tickLabelRotation="-35" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="priceAxis" side="LEFT" forceZeroInRange="false" />
                        </yAxis>
                    </LineChart>
                </VBox>

            </SplitPane>

        </StackPane>
    </center>
</BorderPane>
