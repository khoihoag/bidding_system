<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="26"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bidding.controller.NotificationController"
      stylesheets="@../css/style.css"
      styleClass="notifications-page">

    <HBox alignment="BOTTOM_LEFT" spacing="18" styleClass="notifications-header">
        <VBox spacing="7" HBox.hgrow="ALWAYS">
            <Label text="Thông báo của bạn" styleClass="notifications-title"/>
            <Label text="Cập nhật mới nhất về các phiên đấu giá và tài khoản." styleClass="notifications-subtitle"/>
        </VBox>
        <Button fx:id="markAllReadButton" text="✓ Đánh dấu tất cả là đã đọc" styleClass="notifications-mark-read-button"/>
    </HBox>

    <ListView fx:id="mainNotificationList" VBox.vgrow="ALWAYS" styleClass="notifications-list"/>
</VBox>
