<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bidding.controller.DashboardController"
            stylesheets="@../css/style.css"
            styleClass="content-surface">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="64" minHeight="64" maxHeight="64" styleClass="dashboard-header">
            <padding>
                <Insets top="0" right="24" bottom="0" left="24"/>
            </padding>

            <Label text="Sảnh Đấu Giá" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="0" styleClass="dashboard-header-actions">
                <VBox alignment="CENTER_LEFT" spacing="2" prefWidth="170" minWidth="170" styleClass="dashboard-balance-box">
                    <Label text="Số dư hiện tại" styleClass="dashboard-balance-caption"/>
                    <Label fx:id="dashboardBalanceLabel" text="0 đ" styleClass="dashboard-balance-value"/>
                </VBox>

                <HBox alignment="CENTER_LEFT" fillHeight="false" spacing="12" prefWidth="220" minWidth="220" styleClass="dashboard-user-panel">
                    <StackPane styleClass="avatar-circle dashboard-avatar">
                        <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                            <image><Image url="@../images/icons/user.png"/></image>
                        </ImageView>
                    </StackPane>
                    <VBox spacing="1" HBox.hgrow="ALWAYS">
                        <Label fx:id="dashboardUsernameLabel" text="Người info" styleClass="dashboard-user-name"/>
                        <Label fx:id="dashboardHandleLabel" text="owaycwhmanh" styleClass="dashboard-user-handle"/>
                    </VBox>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-surface">
            <VBox spacing="24" styleClass="dashboard-body">
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="dashboard-search-row">
                    <StackPane HBox.hgrow="ALWAYS">
                        <TextField fx:id="auctionSearchField"
                                   promptText="Tìm theo tên sản phẩm, mã phiên, loại, người bán..."
                                   onAction="#handleAuctionSearch"
                                   styleClass="dashboard-search-field"/>
                        <Label text="⌕" styleClass="dashboard-search-icon" mouseTransparent="true" StackPane.alignment="CENTER_LEFT"/>
                    </StackPane>
                    <Button text="Xóa lọc" onAction="#clearAuctionSearch" styleClass="filter-clear-button"/>
                </HBox>

                <VBox fx:id="auctionContainer" spacing="22"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
