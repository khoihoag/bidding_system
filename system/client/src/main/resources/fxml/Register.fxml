<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.bidding.controller.RegisterController"
           styleClass="login-background"
           stylesheets="@../css/style.css">

    <VBox alignment="CENTER" spacing="14" maxWidth="430" styleClass="login-card" StackPane.alignment="CENTER">
        <Label text="🏆" style="-fx-font-size: 46px; -fx-text-fill: #d2aa2a;"/>
        <VBox alignment="CENTER" spacing="4">
            <Label text="BidVault" styleClass="brand-title"/>
            <Label text="Đăng ký tài khoản" styleClass="hint-label"/>
        </VBox>

        <VBox spacing="11" maxWidth="340" style="-fx-padding: 8 0 0 0;">
            <VBox spacing="5">
                <Label text="Tên đăng nhập" styleClass="field-label"/>
                <TextField fx:id="usernameField" styleClass="input-field"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Họ và Tên" styleClass="field-label"/>
                <TextField fx:id="fullNameField" styleClass="input-field"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Email" styleClass="field-label"/>
                <TextField fx:id="emailField" styleClass="input-field"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Mật khẩu" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" styleClass="input-field"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Xác nhận mật khẩu" styleClass="field-label"/>
                <PasswordField fx:id="confirmPasswordField" styleClass="input-field"/>
            </VBox>

            <Label fx:id="errorLabel" text="" textFill="#b91c1c" visible="false" wrapText="true" style="-fx-font-size: 12px;"/>

            <Button fx:id="registerButton" text="Đăng Ký" maxWidth="Infinity" onAction="#handleRegister" styleClass="primary-button"/>

            <HBox alignment="CENTER" spacing="4">
                <Label text="Đã có tài khoản?" styleClass="hint-label"/>
                <Hyperlink text="Đăng nhập ngay" onAction="#handleBackToLogin" style="-fx-text-fill: #075985; -fx-font-weight: 600; -fx-border-width: 0;"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
