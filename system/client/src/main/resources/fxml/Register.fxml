<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.bidding.controller.RegisterController"
           styleClass="root-pane"
           stylesheets="@../css/style.css">

    <VBox alignment="CENTER" maxWidth="450" maxHeight="650" style="-fx-background-color: #FFFFFF;" StackPane.alignment="CENTER">

        <VBox alignment="CENTER" spacing="10">
            <Label text="BidVault." style="-fx-font-family: 'Georgia', 'Times New Roman', serif; -fx-font-size: 38px; -fx-text-fill: #111111;"/>
            <Label text="Đăng ký tài khoản" style="-fx-font-size: 14px; -fx-text-fill: #6B7280; -fx-letter-spacing: 1px;"/>
            <VBox.margin>
                <Insets bottom="30"/>
            </VBox.margin>
        </VBox>

        <VBox spacing="15" maxWidth="350">
            <VBox spacing="5">
                <Label text="Tên đăng nhập" style="-fx-text-fill: #111111; -fx-font-weight: bold;"/>
                <TextField fx:id="usernameField" styleClass="input-field"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Họ và Tên" style="-fx-text-fill: #111111; -fx-font-weight: bold;"/>
                <TextField fx:id="fullNameField" styleClass="input-field"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Email" style="-fx-text-fill: #111111; -fx-font-weight: bold;"/>
                <TextField fx:id="emailField" styleClass="input-field"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Mật khẩu" style="-fx-text-fill: #111111; -fx-font-weight: bold;"/>
                <PasswordField fx:id="passwordField" styleClass="input-field"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Xác nhận mật khẩu" style="-fx-text-fill: #111111; -fx-font-weight: bold;"/>
                <PasswordField fx:id="confirmPasswordField" styleClass="input-field"/>
            </VBox>

            <Label fx:id="errorLabel" text="" textFill="#D10000" visible="false" wrapText="true" style="-fx-font-size: 12px;"/>

            <Button fx:id="registerButton" text="ĐĂNG KÝ" maxWidth="Infinity" onAction="#handleRegister" styleClass="primary-button" style="-fx-padding: 12; -fx-letter-spacing: 1px;">
                <VBox.margin>
                    <Insets top="10"/>
                </VBox.margin>
            </Button>

            <HBox alignment="CENTER" spacing="5">
                <Label text="Đã có tài khoản?" style="-fx-text-fill: #6B7280;"/>
                <Hyperlink text="Đăng nhập ngay" onAction="#handleBackToLogin" style="-fx-text-fill: #111111; -fx-font-weight: bold; -fx-underline: true; -fx-border-width: 0;"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>