<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bidding.controller.WatchlistController"
            stylesheets="@../css/style.css"
            styleClass="content-surface">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="76" minHeight="76" maxHeight="76" styleClass="dashboard-header">
            <padding>
                <Insets top="0" right="28" bottom="0" left="28"/>
            </padding>
            <VBox spacing="2" alignment="CENTER_LEFT">
                <Label text="THEO DÕI" styleClass="dashboard-header-kicker"/>
                <Label text="Sản phẩm đang theo dõi" styleClass="dashboard-header-title"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Làm mới" onAction="#handleRefresh" styleClass="dashboard-search-clear-button"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-surface">
            <VBox spacing="24" styleClass="dashboard-body">
                <VBox fx:id="watchlistContainer" spacing="22"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
