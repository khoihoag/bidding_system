<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TabPane tabClosingPolicy="UNAVAILABLE"
         xmlns="http://javafx.com/javafx/21"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.bidding.controller.InventoryController"
         stylesheets="@../css/style.css"
         styleClass="content-surface inventory-root">

    <Tab text="Kho Đồ Của Tôi">
        <BorderPane styleClass="inventory-page">
            <center>
                <HBox spacing="32" styleClass="inventory-workspace">
                    <VBox spacing="18" minWidth="560" prefWidth="620" HBox.hgrow="ALWAYS" styleClass="inventory-panel">
                        <VBox spacing="4">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Kho Đồ Của Tôi" styleClass="inventory-title"/>
                            </HBox>
                            <Label text="Chọn một món đồ để xem chi tiết, chỉnh sửa hoặc đưa lên đấu giá." styleClass="hint-label"/>
                        </VBox>

                        <TextField fx:id="txtInventorySearch"
                                   promptText="Tìm kiếm theo tên, ID, mô tả..."
                                   styleClass="inventory-search-field"/>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button fx:id="btnViewSelectedItem"
                                    text="Xem chi tiết"
                                    onAction="#handleViewSelectedItem"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="primary-button"/>
                            <Button fx:id="btnEditSelectedItem"
                                    text="Sửa sản phẩm"
                                    onAction="#handleEditSelectedItem"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="secondary-button"/>
                            <Button text="Làm mới"
                                    onAction="#handleRefreshInventory"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="secondary-button"/>
                        </HBox>

                        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="inventory-scroll">
                            <FlowPane fx:id="inventoryGrid" hgap="18" vgap="18" styleClass="inventory-grid"/>
                        </ScrollPane>
                    </VBox>

                    <VBox spacing="18" minWidth="520" prefWidth="560" maxWidth="620" styleClass="inventory-action-panel">
                        <VBox spacing="4">
                            <Label text="Bảng Thao Tác" styleClass="inventory-title"/>
                            <Label text="Mở phiên, hẹn giờ đấu hoặc nhập vật phẩm mới từ cùng một khu vực." styleClass="hint-label"/>
                        </VBox>

                        <TabPane fx:id="actionTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="sub-tab-pane inventory-action-tabs" VBox.vgrow="ALWAYS">
                            <Tab text="Mở Phiên Đấu Giá">
                                <VBox spacing="16" styleClass="inventory-form-pane">
                                    <VBox spacing="6">
                                        <Label text="Vật phẩm đang chọn" styleClass="field-label"/>
                                        <TextField fx:id="txtItemIdNow" promptText="Chọn vật phẩm từ kho..." editable="false" styleClass="input-field"/>
                                        <TextField fx:id="txtItemIdSchedule" visible="false" managed="false"/>
                                    </VBox>

                                    <GridPane hgap="14" vgap="12">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="50"/>
                                            <ColumnConstraints percentWidth="50"/>
                                        </columnConstraints>
                                        <VBox spacing="6" GridPane.columnIndex="0">
                                            <Label text="Thời gian đấu giá (phút)" styleClass="field-label"/>
                                            <TextField fx:id="txtDuration" promptText="VD: 60" styleClass="input-field"/>
                                        </VBox>
                                        <VBox spacing="6" GridPane.columnIndex="1">
                                            <Label text="Bước giảm giá (VNĐ)" styleClass="field-label"/>
                                            <TextField fx:id="txtDropStepNow" promptText="Chỉ dùng khi đấu giá ngược" disable="true" styleClass="input-field"/>
                                        </VBox>
                                    </GridPane>

                                    <CheckBox fx:id="chkReverseNow" text="Kích hoạt đấu giá ngược" styleClass="inventory-check"/>

                                    <Region VBox.vgrow="ALWAYS"/>
                                    <Button text="Bắt Đầu Phiên Đấu Giá" onAction="#handleStartNow" maxWidth="Infinity" styleClass="primary-button"/>
                                </VBox>
                            </Tab>

                            <Tab text="Hẹn Giờ Đấu">
                                <VBox spacing="16" styleClass="inventory-form-pane">
                                    <GridPane hgap="14" vgap="12">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="50"/>
                                            <ColumnConstraints percentWidth="50"/>
                                        </columnConstraints>
                                        <VBox spacing="6" GridPane.columnIndex="0">
                                            <Label text="Thời gian bắt đầu" styleClass="field-label"/>
                                            <TextField fx:id="txtStartTime" promptText="VD: 2026-05-01T08:00:00" styleClass="input-field"/>
                                        </VBox>
                                        <VBox spacing="6" GridPane.columnIndex="1">
                                            <Label text="Thời gian kết thúc" styleClass="field-label"/>
                                            <TextField fx:id="txtEndTime" promptText="VD: 2026-05-01T20:00:00" styleClass="input-field"/>
                                        </VBox>
                                    </GridPane>

                                    <VBox spacing="6">
                                        <Label text="Bước giảm giá (VNĐ)" styleClass="field-label"/>
                                        <TextField fx:id="txtDropStepSchedule" promptText="Chỉ dùng khi đấu giá ngược" disable="true" styleClass="input-field"/>
                                    </VBox>

                                    <CheckBox fx:id="chkReverseSchedule" text="Kích hoạt đấu giá ngược" styleClass="inventory-check"/>

                                    <Region VBox.vgrow="ALWAYS"/>
                                    <Button text="Đặt Lịch Ngay" onAction="#handleSchedule" maxWidth="Infinity" styleClass="primary-button"/>
                                </VBox>
                            </Tab>

                            <Tab fx:id="itemFormTab" text="Nhập Đồ Mới">
                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="inventory-form-scroll">
                                    <VBox spacing="16" styleClass="inventory-form-pane">
                                        <GridPane hgap="14" vgap="12">
                                            <columnConstraints>
                                                <ColumnConstraints percentWidth="58"/>
                                                <ColumnConstraints percentWidth="42"/>
                                            </columnConstraints>
                                            <VBox spacing="6" GridPane.columnIndex="0">
                                                <Label text="Tên món đồ (*)" styleClass="field-label"/>
                                                <TextField fx:id="txtNewName" promptText="VD: Bức tranh mùa thu" styleClass="input-field"/>
                                            </VBox>
                                            <VBox spacing="6" GridPane.columnIndex="1">
                                                <Label text="Giá khởi điểm (*)" styleClass="field-label"/>
                                                <TextField fx:id="txtNewPrice" promptText="VD: 1500000" styleClass="input-field"/>
                                            </VBox>
                                        </GridPane>

                                        <VBox spacing="6">
                                            <Label text="Mô tả" styleClass="field-label"/>
                                            <TextField fx:id="txtNewDesc" promptText="Mô tả ngắn về tình trạng, nguồn gốc, điểm nổi bật..." styleClass="input-field"/>
                                        </VBox>

                                        <GridPane hgap="14" vgap="12">
                                            <columnConstraints>
                                                <ColumnConstraints percentWidth="50"/>
                                                <ColumnConstraints percentWidth="50"/>
                                            </columnConstraints>
                                            <VBox spacing="6" GridPane.columnIndex="0">
                                                <Label text="Danh mục (*)" styleClass="field-label"/>
                                                <ComboBox fx:id="comboType" promptText="Chọn loại" maxWidth="Infinity" styleClass="combo-box"/>
                                            </VBox>
                                            <VBox spacing="6" GridPane.columnIndex="1">
                                                <Label text="Tình trạng" styleClass="field-label"/>
                                                <ComboBox fx:id="comboCondition" promptText="Chọn tình trạng" maxWidth="Infinity" styleClass="combo-box"/>
                                            </VBox>
                                        </GridPane>

                                        <Label text="Thuộc tính riêng biệt:" styleClass="field-label"/>

                                        <VBox fx:id="vboxArt" spacing="12">
                                            <GridPane hgap="14" vgap="12">
                                                <columnConstraints>
                                                    <ColumnConstraints percentWidth="50"/>
                                                    <ColumnConstraints percentWidth="50"/>
                                                </columnConstraints>
                                                <TextField fx:id="txtArtArtist" promptText="Tên tác giả" GridPane.columnIndex="0" styleClass="input-field"/>
                                                <TextField fx:id="txtArtMedium" promptText="Chất liệu" GridPane.columnIndex="1" styleClass="input-field"/>
                                                <TextField fx:id="txtArtYear" promptText="Năm sáng tác" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="input-field"/>
                                                <TextField fx:id="txtArtDimensions" promptText="Kích thước" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="input-field"/>
                                            </GridPane>
                                        </VBox>

                                        <VBox fx:id="vboxVehicle" spacing="12" visible="false" managed="false">
                                            <GridPane hgap="14" vgap="12">
                                                <columnConstraints>
                                                    <ColumnConstraints percentWidth="50"/>
                                                    <ColumnConstraints percentWidth="50"/>
                                                </columnConstraints>
                                                <TextField fx:id="txtVehMake" promptText="Hãng xe" GridPane.columnIndex="0" styleClass="input-field"/>
                                                <TextField fx:id="txtVehModel" promptText="Mẫu xe" GridPane.columnIndex="1" styleClass="input-field"/>
                                                <TextField fx:id="txtVehYear" promptText="Năm SX" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="input-field"/>
                                                <TextField fx:id="txtVehMileage" promptText="Số KM" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="input-field"/>
                                                <TextField fx:id="txtVehFuel" promptText="Nhiên liệu" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="2" styleClass="input-field"/>
                                            </GridPane>
                                        </VBox>

                                        <VBox fx:id="vboxElectronics" spacing="12" visible="false" managed="false">
                                            <GridPane hgap="14" vgap="12">
                                                <columnConstraints>
                                                    <ColumnConstraints percentWidth="50"/>
                                                    <ColumnConstraints percentWidth="50"/>
                                                </columnConstraints>
                                                <TextField fx:id="txtElecBrand" promptText="Thương hiệu" GridPane.columnIndex="0" styleClass="input-field"/>
                                                <TextField fx:id="txtElecModel" promptText="Model" GridPane.columnIndex="1" styleClass="input-field"/>
                                                <TextField fx:id="txtElecWarranty" promptText="Bảo hành (tháng)" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="input-field"/>
                                                <TextField fx:id="txtElecPower" promptText="Công suất (W)" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="input-field"/>
                                            </GridPane>
                                        </VBox>

                                        <VBox fx:id="imageDropZone"
                                              alignment="CENTER"
                                              spacing="6"
                                              prefHeight="112"
                                              onMouseClicked="#handleSelectImages"
                                              styleClass="inventory-upload-zone">
                                            <Label text="Chọn ảnh vật phẩm" styleClass="inventory-upload-title"/>
                                            <Label text="PNG, JPG - Tối đa 5MB" styleClass="hint-label"/>
                                        </VBox>

                                        <ListView fx:id="listSelectedImages" prefHeight="82" styleClass="inventory-image-list"/>

                                        <HBox spacing="10">
                                            <Button fx:id="btnRemoveSelectedImage" text="Xóa ảnh đã chọn" onAction="#handleRemoveSelectedImage" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="secondary-button"/>
                                            <Button fx:id="btnCancelEdit" text="Hủy chỉnh sửa" onAction="#handleCancelEdit" maxWidth="Infinity" HBox.hgrow="ALWAYS" visible="false" managed="false" styleClass="secondary-button"/>
                                        </HBox>

                                        <Button fx:id="btnSubmitItem" text="Nhập Đồ Mới" onAction="#handleAddNewItem" maxWidth="Infinity" styleClass="primary-button"/>
                                    </VBox>
                                </ScrollPane>
                            </Tab>
                        </TabPane>
                    </VBox>
                </HBox>
            </center>
        </BorderPane>
    </Tab>

    <Tab text="Chiến Lợi Phẩm" onSelectionChanged="#handleRefreshWonItems">
        <VBox spacing="18" styleClass="inventory-page">
            <VBox spacing="4">
                <Label text="Chiến Lợi Phẩm" styleClass="inventory-title"/>
                <Label text="Tài sản bạn đã đấu giá thành công" styleClass="hint-label"/>
            </VBox>
            <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="inventory-scroll">
                <FlowPane fx:id="wonItemsGrid" hgap="18" vgap="18" styleClass="inventory-grid"/>
            </ScrollPane>
        </VBox>
    </Tab>
</TabPane>
