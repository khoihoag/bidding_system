<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bidding.controller.BidHistoryController"
            stylesheets="@../css/style.css"
            styleClass="content-surface"
            prefWidth="1120"
            prefHeight="740">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 16 24 8 24;">
            <Button text="← Quay lại" onAction="#handleBack" styleClass="secondary-button"/>
            <VBox spacing="2">
                <Label text="Lịch Sử Đấu Giá Của Tôi" styleClass="page-title"/>
                <Label fx:id="subtitleLabel" text="Hiển thị các lượt đặt giá của bạn" styleClass="hint-label"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="⟳ Làm mới" onAction="#handleRefresh" styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="18" style="-fx-padding: 8 24 24 24;">
            <HBox spacing="18">
                <HBox alignment="CENTER_LEFT" spacing="16" HBox.hgrow="ALWAYS" styleClass="stat-card" style="-fx-padding: 18;">
                    <Label text="🏆" style="-fx-font-size: 26px; -fx-background-color: #f7f1dd; -fx-background-radius: 8; -fx-padding: 10;"/>
                    <VBox spacing="2">
                        <Label fx:id="totalBidsStatLabel" text="0" styleClass="stat-number"/>
                        <Label text="Tổng lượt đặt" styleClass="stat-desc"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="16" HBox.hgrow="ALWAYS" styleClass="stat-card" style="-fx-padding: 18;">
                    <Label text="✓" style="-fx-font-size: 26px; -fx-text-fill: #16a34a; -fx-background-color: #dcfce7; -fx-background-radius: 8; -fx-padding: 10 14;"/>
                    <VBox spacing="2">
                        <Label fx:id="acceptedBidsStatLabel" text="0" styleClass="stat-number"/>
                        <Label text="Được chấp nhận" styleClass="stat-desc"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="16" HBox.hgrow="ALWAYS" styleClass="stat-card" style="-fx-padding: 18;">
                    <Label text="×" style="-fx-font-size: 28px; -fx-text-fill: #dc2626; -fx-background-color: #fee2e2; -fx-background-radius: 8; -fx-padding: 8 15;"/>
                    <VBox spacing="2">
                        <Label fx:id="rejectedBidsStatLabel" text="0" styleClass="stat-number"/>
                        <Label text="Bị từ chối" styleClass="stat-desc"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="16" HBox.hgrow="ALWAYS" styleClass="stat-card" style="-fx-padding: 18;">
                    <Label text="Σ" style="-fx-font-size: 25px; -fx-text-fill: #b08a1e; -fx-background-color: #f7f1dd; -fx-background-radius: 8; -fx-padding: 10 14;"/>
                    <VBox spacing="2">
                        <Label fx:id="totalAmountStatLabel" text="0 ₫" styleClass="stat-number"/>
                        <Label text="Tổng số tiền đã đặt" styleClass="stat-desc"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="16" HBox.hgrow="ALWAYS" styleClass="stat-card" style="-fx-padding: 18;">
                    <Label text="₫" style="-fx-font-size: 25px; -fx-text-fill: #b08a1e; -fx-background-color: #f7f1dd; -fx-background-radius: 8; -fx-padding: 10 14;"/>
                    <VBox spacing="2">
                        <Label fx:id="highestBidStatLabel" text="0 ₫" styleClass="stat-number"/>
                        <Label text="Lượt đặt cao nhất" styleClass="stat-desc"/>
                    </VBox>
                </HBox>
            </HBox>

            <HBox spacing="14" alignment="CENTER_LEFT">
                <Label text="Lọc theo trạng thái:" styleClass="field-label"/>
                <ComboBox fx:id="statusFilterCombo" promptText="Tất cả" onAction="#handleFilterChange" styleClass="combo-box" prefWidth="180"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="recordCountLabel" text="" styleClass="muted-label"/>
            </HBox>

            <TableView fx:id="historyTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colIndex" text="#" prefWidth="56" resizable="false" sortable="false"/>
                    <TableColumn fx:id="colAuctionId" text="Mã Phiên Đấu Giá" prefWidth="260"/>
                    <TableColumn fx:id="colBidAmount" text="Số Tiền Đặt (₫)" prefWidth="190"/>
                    <TableColumn fx:id="colBidTime" text="Thời Gian Đặt" prefWidth="220"/>
                    <TableColumn fx:id="colBidType" text="Loại" prefWidth="140"/>
                    <TableColumn fx:id="colStatus" text="Trạng Thái" prefWidth="150"/>
                </columns>
            </TableView>

            <Label fx:id="statusLabel" text="" styleClass="muted-label" alignment="CENTER"/>
        </VBox>
    </center>
</BorderPane>
