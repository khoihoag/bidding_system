<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bidding.controller.ItemDetailController"
            style="-fx-background-color: #FFFFFF;" prefWidth="800" prefHeight="750">

    <top>
        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 15 30; -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0; -fx-background-color: #FFFFFF;">
            <Button text="✕ ĐÓNG" onAction="#onBackButtonClicked" style="-fx-background-color: transparent; -fx-text-fill: #111111; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 5 10;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #FFFFFF;">
            <VBox alignment="TOP_CENTER" spacing="30" style="-fx-padding: 40 60;">

                <Label fx:id="itemNameLabel" text="Đang tải..." wrapText="true" textAlignment="CENTER" style="-fx-font-size: 36px; -fx-text-fill: #111111; -fx-font-weight: bold;"/>

                <StackPane style="-fx-background-color: #F9FAFB; -fx-padding: 20; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-max-width: 650;">
                    <ImageView fx:id="itemImageView" fitWidth="600" fitHeight="450" preserveRatio="true" smooth="true"/>
                    <Button fx:id="prevImageButton" text="←" onAction="#showPreviousImage" visible="false" managed="false"
                            StackPane.alignment="CENTER_LEFT"
                            style="-fx-background-color: rgba(128, 128, 128, 0.58); -fx-text-fill: white; -fx-border-color: transparent; -fx-font-size: 20px; -fx-font-weight: bold; -fx-background-radius: 24; -fx-min-width: 48; -fx-min-height: 48; -fx-max-width: 48; -fx-max-height: 48; -fx-cursor: hand;"/>
                    <Button fx:id="nextImageButton" text="→" onAction="#showNextImage" visible="false" managed="false"
                            StackPane.alignment="CENTER_RIGHT"
                            style="-fx-background-color: rgba(128, 128, 128, 0.58); -fx-text-fill: white; -fx-border-color: transparent; -fx-font-size: 20px; -fx-font-weight: bold; -fx-background-radius: 24; -fx-min-width: 48; -fx-min-height: 48; -fx-max-width: 48; -fx-max-height: 48; -fx-cursor: hand;"/>
                    <Label fx:id="imageCounterLabel" visible="false" managed="false"
                           StackPane.alignment="BOTTOM_CENTER"
                           style="-fx-background-color: rgba(128, 128, 128, 0.58); -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 5 12; -fx-background-radius: 14;"/>
                </StackPane>

                <VBox spacing="30" maxWidth="650">

                    <VBox spacing="15">
                        <Label text="Giới thiệu tác phẩm" style="-fx-font-size: 24px; -fx-text-fill: #111111; -fx-font-weight: bold;"/>
                        <Label fx:id="descriptionLabel" wrapText="true" style="-fx-font-size: 16px; -fx-text-fill: #4B5563; -fx-line-spacing: 8px;"/>
                    </VBox>

                    <VBox spacing="15" style="-fx-border-color: #E5E7EB; -fx-border-width: 1 0 0 0; -fx-padding: 20 0 0 0;">
                        <Label text="Thông số chi tiết" style="-fx-font-size: 24px; -fx-text-fill: #111111; -fx-font-weight: bold;"/>
                        <VBox fx:id="specsContainer" spacing="10"/>
                    </VBox>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
