<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bidding.controller.ItemDetailController"
            stylesheets="@../css/style.css"
            styleClass="item-detail-dialog"
            prefWidth="820" prefHeight="590">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="item-detail-header">
            <Label text="CHI TIẾT SẢN PHẨM" styleClass="item-detail-kicker"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Đóng" onAction="#onBackButtonClicked" styleClass="item-detail-close-button"/>
        </HBox>
    </top>

    <center>
        <HBox styleClass="item-detail-content">
            <VBox alignment="CENTER" spacing="16" prefWidth="360" styleClass="item-detail-media-column">
                <StackPane styleClass="item-detail-image-frame">
                    <ImageView fx:id="itemImageView"
                               fitWidth="292" fitHeight="236"
                               preserveRatio="true" smooth="true"/>
                </StackPane>

                <HBox alignment="CENTER" spacing="14" styleClass="item-detail-gallery-controls">
                    <Button fx:id="prevImageButton" text="‹" onAction="#showPreviousImage" styleClass="item-detail-nav-button"/>
                    <Label fx:id="imageCounterLabel" text="1/3" styleClass="item-detail-counter"/>
                    <Button fx:id="nextImageButton" text="›" onAction="#showNextImage" styleClass="item-detail-nav-button"/>
                </HBox>
            </VBox>

            <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" styleClass="item-detail-scroll">
                <VBox spacing="14" styleClass="item-detail-info">
                    <Label fx:id="itemNameLabel" text="Đang tải..." wrapText="true" styleClass="item-detail-title"/>

                    <Separator styleClass="item-detail-separator"/>

                    <Label text="GIỚI THIỆU" styleClass="item-detail-section-label"/>
                    <Label fx:id="descriptionLabel" wrapText="true" styleClass="item-detail-description-text"/>

                    <Label text="THÔNG SỐ CHI TIẾT" styleClass="item-detail-section-label"/>
                    <VBox fx:id="specsContainer" spacing="0" styleClass="item-detail-specs-list"/>

                    <Region VBox.vgrow="ALWAYS" prefHeight="10"/>
                </VBox>
            </ScrollPane>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="item-detail-footer">
            <Button fx:id="deleteItemButton" text="Xóa sản phẩm" onAction="#onDeleteButtonClicked" styleClass="item-detail-delete-button"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="editItemButton" text="Sửa sản phẩm" onAction="#onEditButtonClicked" styleClass="item-detail-edit-button"/>
        </HBox>
    </bottom>
</BorderPane>
