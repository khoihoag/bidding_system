<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="760.0" prefWidth="1200.0" styleClass="entry-shell" stylesheets="@theme.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bidding.client.scene.Scene1">

    <children>
        <VBox maxWidth="500.0" spacing="18.0" styleClass="entry-panel">
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
            </padding>

            <children>
                <Label prefHeight="39.0" prefWidth="118.0" styleClass="entry-title" text="LOGIN">
               <VBox.margin>
                  <Insets left="150.0" />
               </VBox.margin></Label>
                <Label styleClass="entry-subtitle" wrapText="true" />

                <VBox spacing="8.0">
                    <children>
                        <Label styleClass="field-label" text="Username" />
                        <TextField fx:id="usernameField" prefHeight="46.0" promptText="Please enter your username to continue" styleClass="text-input" />
                    </children>
                </VBox>

                <VBox spacing="8.0">
                    <children>
                        <Label styleClass="field-label" text="Password" />
                        <PasswordField fx:id="passwordField" prefHeight="46.0" promptText="Please enter your password to continue" styleClass="password-input" />
                    </children>
                </VBox>

                <HBox alignment="CENTER_RIGHT">
                    <children>
                        <Hyperlink onAction="#handleForgotPassword" styleClass="link-btn" text="Forgot Password" />
                    </children>
                </HBox>

                <Label fx:id="errorLabel" styleClass="status-error" wrapText="true" />

                <HBox spacing="12.0">
                    <children>
                        <Button maxWidth="Infinity" onAction="#handleLogin" styleClass="btn-primary" text="Submit" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="Infinity" onAction="#handleRegisterClick" styleClass="btn-secondary" text="Create An Account" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
