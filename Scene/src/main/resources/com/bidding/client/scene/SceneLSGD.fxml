<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="1280.0"
      prefHeight="820.0"
      spacing="18.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bidding.client.scene.SceneLSGD"
      styleClass="dashboard-root"
      stylesheets="@theme.css">

    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <children>
                <Button text="← Quay lại" onAction="#goBack" styleClass="btn-back" />
                <VBox spacing="4.0">
                    <children>
                        <Label text="Lịch sử giao dịch" styleClass="page-title" />
                        <Label text="Tổng hợp các giao dịch của người mua." styleClass="page-subtitle" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <HBox spacing="18.0">
            <children>
                <VBox styleClass="dashboard-section" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Tổng số giao dịch" styleClass="section-caption" />
                        <Label fx:id="lblTransactionCount" text="0" styleClass="section-title" />
                    </children>
                </VBox>
                <VBox styleClass="dashboard-section" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Tổng tiền đã chi" styleClass="section-caption" />
                        <Label fx:id="lblTotalSpent" text="0 d" styleClass="section-title" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <Label fx:id="lblHistoryNote" text="" styleClass="section-caption" wrapText="true" />

        <TableView fx:id="tableTransactions" VBox.vgrow="ALWAYS" styleClass="page-surface">
            <columns>
                <TableColumn fx:id="colId" text="Mã GD" prefWidth="100.0" />
                <TableColumn fx:id="colItemName" text="Tên sản phẩm" prefWidth="280.0" />
                <TableColumn fx:id="colAmount" text="Số tiền" prefWidth="170.0" />
                <TableColumn fx:id="colTime" text="Thời gian" prefWidth="210.0" />
                <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="180.0" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
