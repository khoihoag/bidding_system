<?xml version="1.0" encoding="UTF-8"?>

<?import com.bidding.client.scene.CountdownTimer?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bidding.client.scene.AuctionCardController"
      fx:id="cardRoot"
      prefWidth="228"
      style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 14; -fx-border-width: 1;">
    <StackPane prefHeight="148"
               onMouseClicked="#handleOpenCard"
               style="-fx-background-color: #f3f4f6; -fx-background-radius: 14 14 0 0; -fx-cursor: hand;">
        <ImageView fx:id="productImageView" fitWidth="228" fitHeight="148" preserveRatio="false" />
        <Label fx:id="lblImageFallback" text="Khong co anh"
               style="-fx-font-size: 14px; -fx-text-fill: #9ca3af;" />
        <HBox alignment="TOP_LEFT" StackPane.alignment="TOP_LEFT" style="-fx-padding: 10;">
            <Label fx:id="lblStatus"
                   style="-fx-font-size: 10px; -fx-font-weight: bold;" />
        </HBox>
        <HBox alignment="TOP_RIGHT" StackPane.alignment="TOP_RIGHT" style="-fx-padding: 10;">
            <Button fx:id="btnWatch" text="Theo doi" onAction="#handleToggleWatch"
                    style="-fx-background-radius: 16; -fx-font-size: 11px; -fx-cursor: hand;" />
        </HBox>
    </StackPane>
    <VBox spacing="7" onMouseClicked="#handleOpenCard"
          style="-fx-padding: 12; -fx-cursor: hand;">
        <Label fx:id="lblCategory"
               style="-fx-font-size: 10px; -fx-text-fill: #6b7280; -fx-background-color: #f3f4f6; -fx-padding: 2 6; -fx-background-radius: 6;" />
        <Label fx:id="lblName" wrapText="true" maxWidth="204"
               style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #111827;" />
        <Label fx:id="lblPrimaryPrice"
               style="-fx-font-size: 12px; -fx-text-fill: #f59e0b; -fx-font-weight: bold;" />
        <Label fx:id="lblCurrentPrice"
               style="-fx-font-size: 12px; -fx-text-fill: #2563eb; -fx-font-weight: bold;" />
        <CountdownTimer fx:id="countdownTimer" />
        <Label fx:id="lblMeta"
               style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" />
        <Label fx:id="lblSeller"
               style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" />
        <Region VBox.vgrow="ALWAYS" />
    </VBox>
</VBox>
