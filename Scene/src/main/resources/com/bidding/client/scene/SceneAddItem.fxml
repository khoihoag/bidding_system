<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bidding.client.scene.SceneAddItem"
            prefWidth="860.0"
            prefHeight="820.0"
            styleClass="dashboard-root"
            stylesheets="@theme.css">

    <children>
        <HBox alignment="CENTER_LEFT" spacing="14.0"
              styleClass="topbar"
              style="-fx-padding: 13 28 13 20;"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <children>
                <Button text="← Quay lai" onAction="#handleCancel" styleClass="btn-back" />
                <Separator orientation="VERTICAL" style="-fx-opacity:0.3;" />
                <VBox spacing="1.0">
                    <children>
                        <Label fx:id="lblPageTitle" text="Them san pham moi"
                               styleClass="brand-title" style="-fx-font-size:18px;" />
                        <Label fx:id="lblSubtitle"
                               text="Man nay chi gui thong tin tao san pham. Len lich dau gia xu ly o man khac."
                               styleClass="section-caption" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label text="BidViet" styleClass="role-badge" />
            </children>
        </HBox>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    AnchorPane.topAnchor="68.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    style="-fx-background-color:transparent; -fx-border-color:transparent;">
            <content>
                <VBox spacing="0.0" style="-fx-padding: 24 40 36 40; -fx-background-color: #f8fafc;">
                    <children>
                        <VBox styleClass="popup-card" style="-fx-padding:20 24 20 24; -fx-background-radius:12;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 0 0 14 0;">
                                    <children>
                                        <Label text="●" style="-fx-text-fill:#1d5fa7; -fx-font-size:10px;" />
                                        <Label text="Thong tin co ban"
                                               style="-fx-font-size:15px; -fx-font-weight:bold; -fx-text-fill:#12263a;" />
                                        <Label text="(chung cho moi loai san pham)" styleClass="section-caption" />
                                    </children>
                                </HBox>

                                <HBox spacing="16.0" style="-fx-padding: 0 0 12 0;">
                                    <children>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox spacing="4.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Ten san pham" styleClass="field-label" />
                                                        <Label text="*" style="-fx-text-fill:#e74c3c; -fx-font-weight:bold;" />
                                                    </children>
                                                </HBox>
                                                <TextField fx:id="txtName"
                                                           prefHeight="40.0"
                                                           styleClass="text-input"
                                                           promptText="Nhap ten san pham (2-200 ky tu)" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0" prefWidth="186.0">
                                            <children>
                                                <HBox spacing="4.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Loai san pham (type)" styleClass="field-label" />
                                                        <Label text="*" style="-fx-text-fill:#e74c3c; -fx-font-weight:bold;" />
                                                    </children>
                                                </HBox>
                                                <ComboBox fx:id="cbType"
                                                          prefWidth="186.0"
                                                          prefHeight="40.0"
                                                          onAction="#handleTypeChange" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox spacing="16.0" style="-fx-padding: 0 0 12 0;">
                                    <children>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox spacing="4.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Gia khoi diem (VND)" styleClass="field-label" />
                                                        <Label text="*" style="-fx-text-fill:#e74c3c; -fx-font-weight:bold;" />
                                                    </children>
                                                </HBox>
                                                <TextField fx:id="txtStartingPrice"
                                                           prefHeight="40.0"
                                                           styleClass="text-input"
                                                           promptText="Chi nhap so, vi du 500000" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0" prefWidth="210.0">
                                            <children>
                                                <HBox spacing="4.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label text="Tinh trang (condition)" styleClass="field-label" />
                                                        <Label text="*" style="-fx-text-fill:#e74c3c; -fx-font-weight:bold;" />
                                                    </children>
                                                </HBox>
                                                <ComboBox fx:id="cbCondition"
                                                          prefWidth="210.0"
                                                          prefHeight="40.0" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <VBox spacing="5.0">
                                    <children>
                                        <HBox spacing="4.0" alignment="CENTER_LEFT">
                                            <children>
                                                <Label text="Mo ta san pham" styleClass="field-label" />
                                                <Label text="*" style="-fx-text-fill:#e74c3c; -fx-font-weight:bold;" />
                                            </children>
                                        </HBox>
                                        <TextArea fx:id="txtDescription"
                                                  prefHeight="90.0"
                                                  wrapText="true"
                                                  styleClass="text-input"
                                                  promptText="Mo ta chi tiet san pham (it nhat 10 ky tu)" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <Region prefHeight="14.0" />

                        <VBox fx:id="panelArt" visible="true" managed="true"
                              styleClass="popup-card" style="-fx-padding:20 24 20 24; -fx-background-radius:12;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 0 0 14 0;">
                                    <children>
                                        <Label text="Art" style="-fx-font-size:15px; -fx-font-weight:bold; -fx-text-fill:#12263a;" />
                                        <Label text="artist · medium · yearCreated · dimensions" styleClass="section-caption" />
                                    </children>
                                </HBox>
                                <HBox spacing="14.0" style="-fx-padding: 0 0 10 0;">
                                    <children>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Nghe si / Tac gia" styleClass="field-label" />
                                                <TextField fx:id="txtArtist" prefHeight="38.0" styleClass="text-input" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Chat lieu (medium)" styleClass="field-label" />
                                                <TextField fx:id="txtMedium" prefHeight="38.0" styleClass="text-input" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <HBox spacing="14.0">
                                    <children>
                                        <VBox spacing="5.0" prefWidth="160.0">
                                            <children>
                                                <Label text="Nam sang tac" styleClass="field-label" />
                                                <TextField fx:id="txtYearCreated" prefHeight="38.0" styleClass="text-input" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Kich thuoc (dimensions)" styleClass="field-label" />
                                                <TextField fx:id="txtDimensions" prefHeight="38.0" styleClass="text-input" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <Region prefHeight="14.0" />

                        <VBox fx:id="panelElectronics" visible="false" managed="false"
                              styleClass="popup-card" style="-fx-padding:20 24 20 24; -fx-background-radius:12;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 0 0 14 0;">
                                    <children>
                                        <Label text="Electronics" style="-fx-font-size:15px; -fx-font-weight:bold; -fx-text-fill:#12263a;" />
                                        <Label text="brand · model · warrantyMonths · powerWatts" styleClass="section-caption" />
                                    </children>
                                </HBox>
                                <HBox spacing="14.0" style="-fx-padding: 0 0 10 0;">
                                    <children>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Hang san xuat (brand)" styleClass="field-label" />
                                                <TextField fx:id="txtBrand" prefHeight="38.0" styleClass="text-input" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Model" styleClass="field-label" />
                                                <TextField fx:id="txtElecModel" prefHeight="38.0" styleClass="text-input" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <HBox spacing="14.0">
                                    <children>
                                        <VBox spacing="5.0" prefWidth="170.0">
                                            <children>
                                                <Label text="Bao hanh (thang)" styleClass="field-label" />
                                                <TextField fx:id="txtWarrantyMonths" prefHeight="38.0" styleClass="text-input" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Cong suat (powerWatts)" styleClass="field-label" />
                                                <TextField fx:id="txtPowerWatts" prefHeight="38.0" styleClass="text-input" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <Region prefHeight="14.0" />

                        <VBox fx:id="panelVehicle" visible="false" managed="false"
                              styleClass="popup-card" style="-fx-padding:20 24 20 24; -fx-background-radius:12;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 0 0 14 0;">
                                    <children>
                                        <Label text="Vehicle" style="-fx-font-size:15px; -fx-font-weight:bold; -fx-text-fill:#12263a;" />
                                        <Label text="make · model · year · mileage · fuelType" styleClass="section-caption" />
                                    </children>
                                </HBox>
                                <HBox spacing="14.0" style="-fx-padding: 0 0 10 0;">
                                    <children>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Hang xe (make)" styleClass="field-label" />
                                                <TextField fx:id="txtMake" prefHeight="38.0" styleClass="text-input" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Ten / Model xe" styleClass="field-label" />
                                                <TextField fx:id="txtVehModel" prefHeight="38.0" styleClass="text-input" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <HBox spacing="14.0">
                                    <children>
                                        <VBox spacing="5.0" prefWidth="150.0">
                                            <children>
                                                <Label text="Nam SX (year)" styleClass="field-label" />
                                                <TextField fx:id="txtYear" prefHeight="38.0" styleClass="text-input" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0" prefWidth="170.0">
                                            <children>
                                                <Label text="So km da chay (mileage)" styleClass="field-label" />
                                                <TextField fx:id="txtMileage" prefHeight="38.0" styleClass="text-input" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Nhien lieu (fuelType)" styleClass="field-label" />
                                                <TextField fx:id="txtFuelType" prefHeight="38.0" styleClass="text-input" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <Region prefHeight="14.0" />

                        <VBox styleClass="popup-card" style="-fx-padding:20 24 20 24; -fx-background-radius:12;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 0 0 12 0;">
                                    <children>
                                        <Label text="Hinh anh san pham"
                                               style="-fx-font-size:15px; -fx-font-weight:bold; -fx-text-fill:#12263a;" />
                                        <Label text="Bat buoc khi them moi" styleClass="section-caption" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="14.0" style="-fx-padding: 0 0 10 0;">
                                    <children>
                                        <Button text="Tai anh len"
                                                onAction="#handleUploadImages"
                                                styleClass="btn-secondary"
                                                style="-fx-font-size:13px; -fx-padding:10 22;" />
                                        <Label fx:id="lblImageCount" text="Chua co anh nao." styleClass="section-caption" />
                                    </children>
                                </HBox>

                                <ScrollPane prefHeight="130.0"
                                            hbarPolicy="AS_NEEDED"
                                            vbarPolicy="NEVER"
                                            style="-fx-background-color:#f1f5f9; -fx-background-radius:8; -fx-border-color:#e2e8f0; -fx-border-radius:8;">
                                    <content>
                                        <HBox fx:id="imageContainer" spacing="10.0">
                                            <padding>
                                                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
                                            </padding>
                                        </HBox>
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>

                        <Region prefHeight="18.0" />

                        <Label fx:id="lblErrorMsg" visible="false" wrapText="true" style="-fx-padding: 0 0 6 0;" />

                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <children>
                                <Button text="Huy bo"
                                        onAction="#handleCancel"
                                        styleClass="btn-back"
                                        style="-fx-font-size:14px; -fx-padding:11 28;" />
                                <Button fx:id="btnSubmit"
                                        text="Dang san pham"
                                        onAction="#handleSubmit"
                                        styleClass="btn-accent"
                                        style="-fx-font-size:14px; -fx-padding:11 34;" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
