<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="1280.0"
      prefHeight="820.0"
      spacing="18.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bidding.client.scene.SceneAutoBid"
      styleClass="dashboard-root"
      stylesheets="@theme.css">

    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <children>
                <Button fx:id="btnBack" text="← Quay lại" onAction="#handleBack" styleClass="btn-back" />
                <VBox spacing="4.0">
                    <children>
                        <Label text="Trả giá tự động" styleClass="page-title" />
                        <Label text="Thiết lập bot trả giá tự động cho người mua." styleClass="page-subtitle" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <VBox styleClass="dashboard-section">
            <children>
                <Label text="Cách hoạt động" styleClass="section-title" />
                <Label fx:id="lblServerNote"
                       text="Tài liệu JSON hiện có REGISTER_AUTO_BID và REGISTER_AUTO_BID_REPLY. Hiện chưa có chức năng lấy danh sách cấu hình đã lưu từ server."
                       wrapText="true"
                       styleClass="section-caption" />
            </children>
        </VBox>

        <HBox spacing="12.0" styleClass="dashboard-section">
            <children>
                <TextField fx:id="txtProductId" promptText="Mã phiên đấu giá" styleClass="text-input" prefWidth="180.0" />
                <TextField fx:id="txtMaxBid" promptText="Giá tối đa" styleClass="text-input" prefWidth="220.0" />
                <TextField fx:id="txtIncrement" promptText="Bước giá" styleClass="text-input" prefWidth="180.0" />
                <Button text="Khởi động bot" onAction="#handleStartBot" styleClass="btn-accent" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblMessage" styleClass="section-caption" />
            </children>
        </HBox>

        <TableView fx:id="tableAutoBid" VBox.vgrow="ALWAYS" styleClass="page-surface">
            <columns>
                <TableColumn fx:id="colProductId" text="Mã SP" prefWidth="110.0" />
                <TableColumn fx:id="colProductName" text="Tên sản phẩm" prefWidth="280.0" />
                <TableColumn fx:id="colCurrentPrice" text="Giá hiện tại" prefWidth="170.0" />
                <TableColumn fx:id="colMaxBid" text="Giá tối đa" prefWidth="170.0" />
                <TableColumn fx:id="colIncrement" text="Bước giá" prefWidth="160.0" />
                <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="180.0" />
            </columns>
        </TableView>
    </children>
</VBox>
