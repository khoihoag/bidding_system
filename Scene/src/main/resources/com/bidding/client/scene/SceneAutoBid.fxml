<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="1280.0"
      prefHeight="820.0"
      spacing="18.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bidding.client.scene.SceneAutoBid"
      styleClass="dashboard-root"
      stylesheets="@theme.css">

    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <children>
                <Button fx:id="btnBack" text="← Quay lai" onAction="#handleBack" styleClass="btn-back" />
                <VBox spacing="4.0">
                    <children>
                        <Label text="Auto Bid" styleClass="page-title" />
                        <Label text="Thiet lap bot tra gia tu dong cho bidder." styleClass="page-subtitle" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <VBox styleClass="dashboard-section">
            <children>
                <Label text="Cach hoat dong" styleClass="section-title" />
                <Label text="Nhap ma san pham, gia toi da va buoc gia. Phan nay hien dang dung du lieu giao dien, chua ket noi backend that."
                       wrapText="true"
                       styleClass="section-caption" />
            </children>
        </VBox>

        <HBox spacing="12.0" styleClass="dashboard-section">
            <children>
                <TextField fx:id="txtProductId" promptText="Ma san pham" styleClass="text-input" prefWidth="180.0" />
                <TextField fx:id="txtMaxBid" promptText="Gia toi da" styleClass="text-input" prefWidth="220.0" />
                <TextField fx:id="txtIncrement" promptText="Buoc gia" styleClass="text-input" prefWidth="180.0" />
                <Button text="Khoi dong bot" onAction="#handleStartBot" styleClass="btn-accent" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblMessage" styleClass="section-caption" />
            </children>
        </HBox>

        <TableView fx:id="tableAutoBid" VBox.vgrow="ALWAYS" styleClass="page-surface">
            <columns>
                <TableColumn fx:id="colProductId" text="Ma SP" prefWidth="110.0" />
                <TableColumn fx:id="colProductName" text="Ten san pham" prefWidth="280.0" />
                <TableColumn fx:id="colCurrentPrice" text="Gia hien tai" prefWidth="170.0" />
                <TableColumn fx:id="colMaxBid" text="Gia toi da" prefWidth="170.0" />
                <TableColumn fx:id="colIncrement" text="Buoc gia" prefWidth="160.0" />
                <TableColumn fx:id="colStatus" text="Trang thai" prefWidth="180.0" />
            </columns>
        </TableView>
    </children>
</VBox>
