<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="1280.0"
      prefHeight="820.0"
      spacing="18.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bidding.client.scene.BidderNotifications"
      styleClass="dashboard-root"
      stylesheets="@theme.css">

    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <children>
                <Button text="← Quay lai" onAction="#handleBackToBidder" styleClass="btn-back" />
                <VBox spacing="4.0">
                    <children>
                        <Label text="Thong Bao" styleClass="page-title" />
                        <Label text="Danh sach thong bao cua bidder." styleClass="page-subtitle" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Danh dau da doc" onAction="#handleMarkAsRead" styleClass="btn-secondary" />
                <Button text="Doc tat ca" onAction="#handleMarkAllAsRead" styleClass="btn-accent" />
            </children>
        </HBox>

        <ListView fx:id="notificationListView" VBox.vgrow="ALWAYS" styleClass="page-surface" />
    </children>
</VBox>
