<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.bidding.client.scene.AutoBidPanelController"
      spacing="0"
      style="-fx-background-color: #FAFAFA;">
    <HBox alignment="CENTER_LEFT" spacing="8"
          style="-fx-padding: 12 16; -fx-border-color: #E0E0E0; -fx-border-width: 0 0 1 0; -fx-cursor: hand;"
          onMouseClicked="#handleTogglePanel">
        <Label text="Auto" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #757575;"/>
        <Label text="AUTO-BID (Dau gia tu dong)" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #424242;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ToggleButton fx:id="toggleAutoBid" text="TAT"
                      onAction="#handleToggleAutoBid"
                      style="-fx-background-color: #E0E0E0; -fx-text-fill: #757575; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 3 10;"/>
        <Label fx:id="lblExpandIcon" text="v" style="-fx-font-size: 10px; -fx-text-fill: #9E9E9E;"/>
    </HBox>
    <VBox fx:id="panelBody" spacing="12" style="-fx-padding: 14 16;">
        <VBox spacing="4">
            <Label text="Gia toi da (maxBid)" style="-fx-font-size: 11px; -fx-text-fill: #757575;"/>
            <TextField fx:id="txtMaxBid" promptText="Nhap gia toi da..."
                       style="-fx-font-size: 13px; -fx-padding: 8 10; -fx-border-color: #BDBDBD; -fx-border-radius: 4; -fx-background-radius: 4; -fx-background-color: white;"/>
            <Label fx:id="lblMaxBidValidation" text="" style="-fx-font-size: 11px; -fx-text-fill: #D32F2F;" visible="false" managed="false"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Buoc gia tu dong (increment)" style="-fx-font-size: 11px; -fx-text-fill: #757575;"/>
            <TextField fx:id="txtIncrement" promptText="Nhap buoc gia..."
                       style="-fx-font-size: 13px; -fx-padding: 8 10; -fx-border-color: #BDBDBD; -fx-border-radius: 4; -fx-background-radius: 4; -fx-background-color: white;"/>
        </VBox>
        <Label text="He thong se tu dong dat gia thay ban theo buoc gia khi co bid moi, khong vuot qua maxBid."
               wrapText="true"
               style="-fx-font-size: 11px; -fx-text-fill: #757575; -fx-background-color: #E3F2FD; -fx-padding: 8; -fx-background-radius: 4;"/>
        <Button fx:id="btnSaveAutoBid" text="LUU CAI DAT AUTO-BID"
                onAction="#handleSaveAutoBid" maxWidth="Infinity"
                style="-fx-background-color: #37474F; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 9 0; -fx-background-radius: 4; -fx-cursor: hand;"/>
        <Label fx:id="lblSaveResult" text="" style="-fx-font-size: 11px; -fx-text-fill: #2E7D32;" visible="false" managed="false"/>
        <VBox fx:id="vboxCurrentAutoBid" spacing="4" style="-fx-background-color: #F3E5F5; -fx-padding: 8; -fx-background-radius: 4;" visible="false" managed="false">
            <Label text="AUTO-BID DANG HOAT DONG" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #7B1FA2;"/>
            <HBox spacing="6">
                <Label text="Max:" style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
                <Label fx:id="lblActiveMaxBid" text="---" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #7B1FA2;"/>
            </HBox>
            <HBox spacing="6">
                <Label text="Buoc:" style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
                <Label fx:id="lblActiveIncrement" text="---" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #7B1FA2;"/>
            </HBox>
        </VBox>
        <Label text="[DB] Luu AutoBidConfig -> POST /api/auto-bid | Validate maxBid > currentPrice"
               wrapText="true"
               style="-fx-font-size: 10px; -fx-text-fill: #795548; -fx-background-color: #FFF9C4; -fx-padding: 5 6; -fx-background-radius: 3;"/>
    </VBox>
</VBox>
