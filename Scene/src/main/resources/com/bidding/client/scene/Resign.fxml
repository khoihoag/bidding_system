<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="760.0" prefWidth="1200.0" styleClass="entry-shell" stylesheets="@theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bidding.client.scene.Resign">

    <VBox alignment="CENTER" maxWidth="500.0" spacing="20.0" styleClass="entry-panel">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
        </padding>
        
        <children>
            <Label styleClass="entry-title" text="Tạo tài khoản" />
            <Label styleClass="entry-subtitle" text="Nhập thông tin của bạn để tạo tài khoản mới" textAlignment="CENTER" wrapText="true" />

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <children>
                    <Label styleClass="field-label" text="Tên đăng nhập" />
                    <TextField fx:id="txtUsername" prefHeight="46.0" promptText="Nhập tên đăng nhập" styleClass="text-input" />
                </children>
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <children>
                    <Label styleClass="field-label" text="Họ và tên" />
                    <TextField fx:id="txtFullName" prefHeight="46.0" promptText="Nhập họ và tên đầy đủ" styleClass="text-input" />
                </children>
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <children>
                    <Label styleClass="field-label" text="Email" />
                    <TextField fx:id="txtGmail" prefHeight="46.0" promptText="Nhập địa chỉ email" styleClass="text-input" />
                </children>
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <children>
                    <Label styleClass="field-label" text="Mật khẩu" />
                    <StackPane>
                        <children>
                            <PasswordField fx:id="txtPassword" prefHeight="46.0" promptText="Nhập mật khẩu" styleClass="password-input" />
                            <TextField fx:id="txtPasswordShow" prefHeight="46.0" promptText="Nhập mật khẩu" styleClass="text-input" visible="false" />
                            <CheckBox fx:id="checkShowPass" onAction="#togglePass" style="-fx-text-fill: #17324d; -fx-font-weight: bold; -fx-cursor: hand;" text="Hiện mật khẩu" StackPane.alignment="CENTER_RIGHT">
                                <StackPane.margin>
                                    <Insets right="12.0" />
                                </StackPane.margin>
                            </CheckBox>
                        </children>
                    </StackPane>
                </children>
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <children>
                    <Label styleClass="field-label" text="Nhập lại mật khẩu" />
                    <PasswordField fx:id="txtConfirmPassword" prefHeight="46.0" promptText="Nhập lại mật khẩu" styleClass="password-input" />
                </children>
            </VBox>

            <Label fx:id="errorLabel" styleClass="status-error" wrapText="true" />

            <HBox alignment="CENTER" spacing="12.0">
                <children>
                    <Button maxWidth="Infinity" onAction="#handleRegister" styleClass="btn-primary" text="Đăng ký" HBox.hgrow="ALWAYS" />
                    <Button maxWidth="Infinity" onAction="#handleBackToLogin" styleClass="btn-secondary" text="Quay lại" HBox.hgrow="ALWAYS" />
                </children>
            </HBox>
        </children>
    </VBox>
</StackPane>
