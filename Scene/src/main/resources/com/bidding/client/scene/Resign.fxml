<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="760.0" prefWidth="1200.0" styleClass="entry-shell" stylesheets="@theme.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bidding.client.scene.Resign">

    <VBox alignment="CENTER" maxWidth="500.0" spacing="20.0" styleClass="entry-panel">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
        </padding>
        
        <children>
            <Label styleClass="entry-title" text="Create An Account" />
            <Label styleClass="entry-subtitle" text="Enter your informatiom to create an account" textAlignment="CENTER" wrapText="true" />

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <children>
                    <Label styleClass="field-label" text="Username" />
                    <TextField fx:id="txtUsername" prefHeight="46.0" promptText="Nhap username" styleClass="text-input" />
                </children>
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <children>
                    <Label styleClass="field-label" text="Gmail" />
                    <TextField fx:id="txtGmail" prefHeight="46.0" promptText="Nhap dia chi gmail" styleClass="text-input" />
                </children>
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <children>
                    <Label styleClass="field-label" text="Mat khau" />
                    <StackPane>
                        <children>
                            <PasswordField fx:id="txtPassword" prefHeight="46.0" promptText="Nhap mat khau" styleClass="password-input" />
                            <TextField fx:id="txtPasswordShow" prefHeight="46.0" promptText="Nhap mat khau" styleClass="text-input" visible="false" />
                            <CheckBox fx:id="checkShowPass" onAction="#togglePass" style="-fx-text-fill: #17324d; -fx-font-weight: bold; -fx-cursor: hand;" text="Hien" StackPane.alignment="CENTER_RIGHT">
                                <StackPane.margin>
                                    <Insets right="12.0" />
                                </StackPane.margin>
                            </CheckBox>
                        </children>
                    </StackPane>
                </children>
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <children>
                    <Label styleClass="field-label" text="Nhap lai mat khau" />
                    <PasswordField fx:id="txtConfirmPassword" prefHeight="46.0" promptText="Nhap lai mat khau" styleClass="password-input" />
                </children>
            </VBox>

            <Label fx:id="errorLabel" styleClass="status-error" wrapText="true" />

            <HBox alignment="CENTER" spacing="12.0">
                <children>
                    <Button maxWidth="Infinity" onAction="#handleRegister" styleClass="btn-primary" text="Submit" HBox.hgrow="ALWAYS" />
                    <Button maxWidth="Infinity" onAction="#handleBackToLogin" styleClass="btn-secondary" text="Back" HBox.hgrow="ALWAYS" />
                </children>
            </HBox>
        </children>
    </VBox>
</StackPane>
