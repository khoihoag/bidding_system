<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="overlayRoot" managed="false" style="-fx-background-color: rgba(0,0,0,0.55);" visible="false" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bidding.client.scene.BidResultOverlayController">
    <VBox alignment="CENTER" maxHeight="380" maxWidth="420" spacing="0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 24, 0, 0, 8);">
        <HBox fx:id="hboxBanner" alignment="CENTER" prefHeight="80" style="-fx-background-color: #1565C0; -fx-background-radius: 8 8 0 0;">
            <Label fx:id="lblBannerIcon" style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold;" text="OK" />
        </HBox>
        <VBox alignment="CENTER" spacing="16" style="-fx-padding: 28 32;">
            <Label fx:id="lblResultTitle" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #212121;" text="Phien dau gia da ket thuc!" textAlignment="CENTER" wrapText="true" />
            <Label fx:id="lblResultSubtitle" style="-fx-font-size: 14px; -fx-text-fill: #616161;" text="" textAlignment="CENTER" wrapText="true" />
            <VBox fx:id="vboxWinnerInfo" alignment="CENTER" managed="false" spacing="6" style="-fx-background-color: #F5F5F5; -fx-padding: 12 16; -fx-background-radius: 6;" visible="false">
                <Label style="-fx-font-size: 11px; -fx-text-fill: #9E9E9E; -fx-font-weight: bold;" text="GIA THANG" />
                <Label fx:id="lblWinningPrice" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1565C0;" text="---" />
                <Label fx:id="lblProductLabel" style="-fx-font-size: 12px; -fx-text-fill: #757575;" text="---" />
            </VBox>
            <Label fx:id="lblDbNote" managed="false" style="-fx-font-size: 10px; -fx-text-fill: #795548; -fx-background-color: #FFF9C4; -fx-padding: 5 8; -fx-background-radius: 3;" text="" textAlignment="CENTER" visible="false" wrapText="true" />
            <HBox alignment="CENTER" spacing="12">
                <Button fx:id="btnSecondary" onAction="#handleSecondary" style="-fx-background-color: white; -fx-border-color: #BDBDBD; -fx-border-radius: 4; -fx-background-radius: 4; -fx-text-fill: #424242; -fx-font-size: 13px; -fx-padding: 10 18; -fx-cursor: hand;" text="Xem san pham khac" />
                <Button fx:id="btnPrimary" onAction="#handlePrimary" style="-fx-background-color: #1565C0; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 18; -fx-background-radius: 4; -fx-cursor: hand;" text="Xac nhan thanh toan" />
            </HBox>
        </VBox>
    </VBox>
</StackPane>
