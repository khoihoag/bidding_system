<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bidding.client.scene.BidHistoryTableController"
      spacing="8"
      style="-fx-padding: 10 4 4 4;">
    <TableView fx:id="bidHistoryTable" prefHeight="170"
               style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8;">
        <columns>
            <TableColumn fx:id="colBidder" text="Nguoi dat" prefWidth="160" />
            <TableColumn fx:id="colBidPrice" text="Gia dat (d)" prefWidth="150" />
            <TableColumn fx:id="colBidTime" text="Thoi gian" prefWidth="190" />
        </columns>
    </TableView>
    <Label text="Ten bidder duoc an bot de bao mat."
           style="-fx-font-size: 11px; -fx-text-fill: #9ca3af; -fx-font-style: italic;" />
    <Label text="[DB] GET /api/bids/{auctionId}?limit=50 de do lich su bid vao bang nay."
           wrapText="true"
           style="-fx-font-size: 11px; -fx-text-fill: #8a5a00; -fx-background-color: #fff7d6; -fx-background-radius: 8; -fx-padding: 8 10;" />
</VBox>
