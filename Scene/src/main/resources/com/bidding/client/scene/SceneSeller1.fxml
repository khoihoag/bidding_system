<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bidding.client.scene.SceneSeller1"
            prefWidth="1280.0"
            prefHeight="820.0"
            styleClass="dashboard-root"
            stylesheets="@theme.css">

    <children>
        <VBox styleClass="top-shell" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" styleClass="topbar" spacing="16.0" style="-fx-padding: 12 24 12 24;">
                    <children>
                        <Button text="Trình đơn" onAction="#toggleMenu" styleClass="menu-toggle" />
                        <Label text="BidViet" styleClass="brand-title" />
                        <Label text="NGUOI BAN" styleClass="role-badge" />
                        <Region HBox.hgrow="ALWAYS" />
                        
                        <Button fx:id="btnAvatar" onAction="#toggleAccountPopup" 
                                style="-fx-background-radius: 50em; -fx-min-width: 42px; -fx-min-height: 42px; -fx-max-width: 42px; -fx-max-height: 42px; -fx-background-color: #cbd5e1; -fx-cursor: hand; -fx-padding: 0;">
                            <graphic>
                                <Label text="A" style="-fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-size: 16px;" />
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>

        <VBox spacing="18.0" AnchorPane.topAnchor="80.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.bottomAnchor="24.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label text="Sản phẩm của tôi" styleClass="page-title" />
                                <Label fx:id="lblProductCount" text="0 sản phẩm đang hiển thị" styleClass="page-subtitle" />
                                <Label fx:id="lblSellerNote" text="" styleClass="section-caption" wrapText="true" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnFilterAll" text="Tất cả" onAction="#filterAll" styleClass="btn-secondary" />
                        <Button fx:id="btnFilterActive" text="Đang đấu giá" onAction="#filterActive" styleClass="btn-secondary" />
                        <Button fx:id="btnFilterEnded" text="Đã kết thúc" onAction="#filterEnded" styleClass="btn-secondary" />
                        <Button text="Thêm sản phẩm" onAction="#showAddProductPopup" styleClass="btn-accent" />
                    </children>
                </HBox>

                <ScrollPane fitToWidth="true" styleClass="page-surface" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="productContainer" hgap="18.0" vgap="18.0" style="-fx-padding: 12;" />
                    </content>
                </ScrollPane>
            </children>
        </VBox>

        <AnchorPane fx:id="dimOverlay"
                    visible="false"
                    onMouseClicked="#closePopups"
                    style="-fx-background-color: rgba(15, 23, 42, 0.36);"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" />

        <!-- SIDE MENU - Sửa để không lòi ra -->
        <AnchorPane fx:id="sideMenu"
                    prefWidth="300.0"
                    styleClass="drawer"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    visible="false"
                    managed="false">
            <children>
                <VBox spacing="0.0" prefWidth="300.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                    <children>
                        <VBox styleClass="drawer-header" spacing="6.0" style="-fx-padding: 24 18 18 18;">
                            <children>
                                <Label text="BidViet" styleClass="drawer-title" />
                                <Label text="Giao diện người bán được đồng bộ màu sắc và kích thước với người mua." styleClass="drawer-subtitle" wrapText="true" />
                            </children>
                        </VBox>

                        <VBox spacing="2.0" style="-fx-padding: 14 0;">
                            <children>
                                <Button text="Sản phẩm của tôi" styleClass="drawer-button drawer-button-active" maxWidth="Infinity" />
                                <Button text="Thêm sản phẩm" onAction="#showAddProductPopup" styleClass="drawer-button" maxWidth="Infinity" />
                                <Button text="Quản lý đấu giá" onAction="#handleManageAuctions" styleClass="drawer-button" maxWidth="Infinity" />
                                <Button text="Thống kê doanh thu" onAction="#handleRevenueStats" styleClass="drawer-button" maxWidth="Infinity" />
                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />
                        <Separator />
                        <VBox spacing="10.0" style="-fx-padding: 18;">
                            <children>
                                <Button text="Chuyển sang người mua" onAction="#switchToBidder" styleClass="btn-secondary" maxWidth="Infinity" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </AnchorPane>

        <AnchorPane fx:id="accountPopup"
                    prefWidth="280.0"
                    visible="false"
                    styleClass="popup-card"
                    AnchorPane.topAnchor="70.0"
                    AnchorPane.rightAnchor="24.0">
            <children>
                <VBox spacing="14.0" AnchorPane.topAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" alignment="TOP_CENTER">
                    <children>
                        <Label text="Trần Văn A" styleClass="page-subtitle" />
                        <Label text="Tài khoản người bán" styleClass="field-label" />
                        
                        <Button text="Cập nhật ảnh đại diện" onAction="#handleUploadAvatar" styleClass="btn-secondary" maxWidth="Infinity" style="-fx-font-size: 12px;"/>
                        
                        <Separator />
                        <Label text="Doanh thu hiện đang là dữ liệu giao diện." styleClass="section-caption" wrapText="true" alignment="CENTER"/>
                        <Button text="Đăng xuất" onAction="#handleLogout" styleClass="btn-danger" maxWidth="Infinity" />
                    </children>
                </VBox>
            </children>
        </AnchorPane>

        <AnchorPane fx:id="addProductPopup"
                    prefWidth="700.0"
                    prefHeight="650.0"
                    visible="false"
                    styleClass="popup-card"
                    AnchorPane.topAnchor="92.0"
                    AnchorPane.leftAnchor="290.0">
            <children>
                <VBox spacing="14.0" AnchorPane.topAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.bottomAnchor="24.0" AnchorPane.leftAnchor="24.0">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label fx:id="lblPopupTitle" text="Thêm sản phẩm mới" styleClass="page-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="Đóng" onAction="#handleCancelAction" styleClass="btn-back" />
                            </children>
                        </HBox>

                        <Label text="Tên sản phẩm" styleClass="field-label" />
                        <TextField fx:id="txtTenSP" prefHeight="42.0" styleClass="text-input" promptText="Nhập tên sản phẩm" />

                        <Label text="Giá khởi điểm" styleClass="field-label" />
                        <TextField fx:id="txtGiaKhoiDiem" prefHeight="42.0" styleClass="text-input" promptText="Chỉ nhập số" />

                        <Label text="Mô tả" styleClass="field-label" />
                        <TextArea fx:id="txtMoTa" prefHeight="100.0" wrapText="true" styleClass="text-input" promptText="Mô tả chi tiết sản phẩm" />

                        <Label text="Thời gian kết thúc" styleClass="field-label" />
                        <HBox spacing="10.0">
                            <children>
                                <DatePicker fx:id="datePicker" prefWidth="170.0" />
                                <ComboBox fx:id="cbGio" prefWidth="90.0" />
                                <ComboBox fx:id="cbPhut" prefWidth="90.0" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Button text="Tải ảnh lên" onAction="#handleUploadImages" styleClass="btn-secondary" />
                                <Label text="Bạn có thể chọn nhiều ảnh." styleClass="section-caption" />
                            </children>
                        </HBox>

                        <ScrollPane fx:id="imageScrollPane" prefHeight="120.0" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" styleClass="panel-soft">
                            <content>
                                <HBox fx:id="imageContainer" spacing="10.0">
                                    <padding>
                                        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
                                    </padding>
                                </HBox>
                            </content>
                        </ScrollPane>

                        <Label fx:id="lblErrorMsg" visible="false" wrapText="true" />

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button text="Hủy" onAction="#handleCancelAction" styleClass="btn-back" />
                                <Button fx:id="btnSubmitProduct" text="Đăng sản phẩm" onAction="#handleAddProductSubmit" styleClass="btn-accent" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </AnchorPane>

        <AnchorPane fx:id="viewProductPopup"
                    prefWidth="840.0"
                    prefHeight="650.0"
                    visible="false"
                    styleClass="popup-card"
                    AnchorPane.topAnchor="92.0"
                    AnchorPane.leftAnchor="220.0">
            <children>
                <VBox spacing="18.0" AnchorPane.topAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.bottomAnchor="24.0" AnchorPane.leftAnchor="24.0">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Chi tiết sản phẩm" styleClass="page-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="Đóng" onAction="#closeViewPopup" styleClass="btn-back" />
                            </children>
                        </HBox>

                        <HBox spacing="18.0" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox spacing="12.0" prefWidth="300.0" styleClass="panel-soft">
                                    <padding>
                                        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
                                    </padding>
                                    <children>
                                        <ScrollPane fx:id="viewImageScroll" prefHeight="230.0" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" fitToHeight="true">
                                            <content>
                                                <HBox fx:id="viewImageContainer" spacing="10.0">
                                                    <padding>
                                                        <Insets top="8.0" right="8.0" bottom="8.0" left="8.0" />
                                                    </padding>
                                                </HBox>
                                            </content>
                                        </ScrollPane>
                                        <Label fx:id="viewLblStatus" text="Trạng thái" styleClass="field-label" />
                                        <Label fx:id="viewLblBidCount" text="0 lượt" styleClass="section-caption" />
                                        <Label fx:id="viewLblCurrentPrice" text="0 đ" styleClass="section-caption" />
                                    </children>
                                </VBox>

                                <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="viewLblName" text="Tên sản phẩm" styleClass="page-title" wrapText="true" />
                                        <Label text="Giá khởi điểm" styleClass="field-label" />
                                        <Label fx:id="viewLblPrice" text="0 đ" styleClass="toolbar-balance" />
                                        <Label text="Kết thúc lúc" styleClass="field-label" />
                                        <Label fx:id="viewLblEndTime" text="--" styleClass="section-caption" />
                                        <Label text="Mô tả" styleClass="field-label" />
                                        <Label fx:id="viewLblDesc" text="--" wrapText="true" styleClass="section-caption" />
                                        <HBox spacing="10.0">
                                             <children>
                                                 <Button text="Chỉnh sửa" onAction="#handleEditFromView" styleClass="btn-accent" />
                                                 <Button text="Mở phiên ngay" onAction="#handleStartAuctionNow" styleClass="btn-secondary" />
                                                 <Button text="Xóa sản phẩm" onAction="#handleDeleteFromView" styleClass="btn-danger" />
                                             </children>
                                         </HBox>
                                        <Label fx:id="viewLblMsg" visible="false" wrapText="true" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
