<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bidding.client.scene.SceneSeller1"
            prefWidth="1280.0"
            prefHeight="820.0"
            styleClass="dashboard-root"
            stylesheets="@theme.css">

    <children>
        <VBox styleClass="top-shell" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" styleClass="topbar" spacing="16.0" style="-fx-padding: 12 24 12 24;">
                    <children>
                        <Button text="Menu" onAction="#toggleMenu" styleClass="menu-toggle" />
                        <Label text="BidViet" styleClass="brand-title" />
                        <Label text="SELLER" styleClass="role-badge" />
                        <Region HBox.hgrow="ALWAYS" />
                        
                        <Button fx:id="btnAvatar" onAction="#toggleAccountPopup" 
                                style="-fx-background-radius: 50em; -fx-min-width: 42px; -fx-min-height: 42px; -fx-max-width: 42px; -fx-max-height: 42px; -fx-background-color: #cbd5e1; -fx-cursor: hand; -fx-padding: 0;">
                            <graphic>
                                <Label text="A" style="-fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-size: 16px;" />
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>

        <VBox spacing="18.0" AnchorPane.topAnchor="80.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.bottomAnchor="24.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label text="San pham cua toi" styleClass="page-title" />
                                <Label fx:id="lblProductCount" text="0 san pham dang hien thi" styleClass="page-subtitle" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnFilterAll" text="Tat ca" onAction="#filterAll" styleClass="btn-secondary" />
                        <Button fx:id="btnFilterActive" text="Dang dau gia" onAction="#filterActive" styleClass="btn-secondary" />
                        <Button fx:id="btnFilterEnded" text="Da ket thuc" onAction="#filterEnded" styleClass="btn-secondary" />
                        <Button text="Them san pham" onAction="#showAddProductPopup" styleClass="btn-accent" />
                    </children>
                </HBox>

                <ScrollPane fitToWidth="true" styleClass="page-surface" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="productContainer" hgap="18.0" vgap="18.0" style="-fx-padding: 12;" />
                    </content>
                </ScrollPane>
            </children>
        </VBox>

        <AnchorPane fx:id="dimOverlay"
                    visible="false"
                    onMouseClicked="#closePopups"
                    style="-fx-background-color: rgba(15, 23, 42, 0.36);"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" />

        <!-- SIDE MENU - Sửa để không lòi ra -->
        <AnchorPane fx:id="sideMenu"
                    prefWidth="300.0"
                    styleClass="drawer"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    visible="false"
                    managed="false">
            <children>
                <VBox spacing="0.0" prefWidth="300.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                    <children>
                        <VBox styleClass="drawer-header" spacing="6.0" style="-fx-padding: 24 18 18 18;">
                            <children>
                                <Label text="BidViet" styleClass="drawer-title" />
                                <Label text="Seller dung cung he mau va kich thuoc voi bidder." styleClass="drawer-subtitle" wrapText="true" />
                            </children>
                        </VBox>

                        <VBox spacing="2.0" style="-fx-padding: 14 0;">
                            <children>
                                <Button text="San pham cua toi" styleClass="drawer-button drawer-button-active" maxWidth="Infinity" />
                                <Button text="Them san pham" onAction="#showAddProductPopup" styleClass="drawer-button" maxWidth="Infinity" />
                                <Button text="Quan ly dau gia" onAction="#handleManageAuctions" styleClass="drawer-button" maxWidth="Infinity" />
                                <Button text="Thong ke doanh thu" onAction="#handleRevenueStats" styleClass="drawer-button" maxWidth="Infinity" />
                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />
                        <Separator />
                        <VBox spacing="10.0" style="-fx-padding: 18;">
                            <children>
                                <Button text="Chuyen sang bidder" onAction="#switchToBidder" styleClass="btn-secondary" maxWidth="Infinity" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </AnchorPane>

        <AnchorPane fx:id="accountPopup"
                    prefWidth="280.0"
                    visible="false"
                    styleClass="popup-card"
                    AnchorPane.topAnchor="70.0"
                    AnchorPane.rightAnchor="24.0">
            <children>
                <VBox spacing="14.0" AnchorPane.topAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" alignment="TOP_CENTER">
                    <children>
                        <Label text="Tran Van A" styleClass="page-subtitle" />
                        <Label text="Tai khoan seller" styleClass="field-label" />
                        
                        <Button text="Cap nhat Avatar" onAction="#handleUploadAvatar" styleClass="btn-secondary" maxWidth="Infinity" style="-fx-font-size: 12px;"/>
                        
                        <Separator />
                        <Label text="Doanh thu hien dang la du lieu giao dien." styleClass="section-caption" wrapText="true" alignment="CENTER"/>
                        <Button text="Dang xuat" onAction="#handleLogout" styleClass="btn-danger" maxWidth="Infinity" />
                    </children>
                </VBox>
            </children>
        </AnchorPane>

        <AnchorPane fx:id="addProductPopup"
                    prefWidth="700.0"
                    prefHeight="650.0"
                    visible="false"
                    styleClass="popup-card"
                    AnchorPane.topAnchor="92.0"
                    AnchorPane.leftAnchor="290.0">
            <children>
                <VBox spacing="14.0" AnchorPane.topAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.bottomAnchor="24.0" AnchorPane.leftAnchor="24.0">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label fx:id="lblPopupTitle" text="Them san pham moi" styleClass="page-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="Dong" onAction="#handleCancelAction" styleClass="btn-back" />
                            </children>
                        </HBox>

                        <Label text="Ten san pham" styleClass="field-label" />
                        <TextField fx:id="txtTenSP" prefHeight="42.0" styleClass="text-input" promptText="Nhap ten san pham" />

                        <Label text="Gia khoi diem" styleClass="field-label" />
                        <TextField fx:id="txtGiaKhoiDiem" prefHeight="42.0" styleClass="text-input" promptText="Chi nhap so" />

                        <Label text="Mo ta" styleClass="field-label" />
                        <TextArea fx:id="txtMoTa" prefHeight="100.0" wrapText="true" styleClass="text-input" promptText="Mo ta chi tiet san pham" />

                        <Label text="Thoi gian ket thuc" styleClass="field-label" />
                        <HBox spacing="10.0">
                            <children>
                                <DatePicker fx:id="datePicker" prefWidth="170.0" />
                                <ComboBox fx:id="cbGio" prefWidth="90.0" />
                                <ComboBox fx:id="cbPhut" prefWidth="90.0" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Button text="Tai anh len" onAction="#handleUploadImages" styleClass="btn-secondary" />
                                <Label text="Ban co the chon nhieu anh." styleClass="section-caption" />
                            </children>
                        </HBox>

                        <ScrollPane fx:id="imageScrollPane" prefHeight="120.0" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" styleClass="panel-soft">
                            <content>
                                <HBox fx:id="imageContainer" spacing="10.0">
                                    <padding>
                                        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
                                    </padding>
                                </HBox>
                            </content>
                        </ScrollPane>

                        <Label fx:id="lblErrorMsg" visible="false" wrapText="true" />

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button text="Huy" onAction="#handleCancelAction" styleClass="btn-back" />
                                <Button fx:id="btnSubmitProduct" text="Dang san pham" onAction="#handleAddProductSubmit" styleClass="btn-accent" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </AnchorPane>

        <AnchorPane fx:id="viewProductPopup"
                    prefWidth="840.0"
                    prefHeight="650.0"
                    visible="false"
                    styleClass="popup-card"
                    AnchorPane.topAnchor="92.0"
                    AnchorPane.leftAnchor="220.0">
            <children>
                <VBox spacing="18.0" AnchorPane.topAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.bottomAnchor="24.0" AnchorPane.leftAnchor="24.0">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Chi tiet san pham" styleClass="page-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="Dong" onAction="#closeViewPopup" styleClass="btn-back" />
                            </children>
                        </HBox>

                        <HBox spacing="18.0" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox spacing="12.0" prefWidth="300.0" styleClass="panel-soft">
                                    <padding>
                                        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
                                    </padding>
                                    <children>
                                        <ScrollPane fx:id="viewImageScroll" prefHeight="230.0" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" fitToHeight="true">
                                            <content>
                                                <HBox fx:id="viewImageContainer" spacing="10.0">
                                                    <padding>
                                                        <Insets top="8.0" right="8.0" bottom="8.0" left="8.0" />
                                                    </padding>
                                                </HBox>
                                            </content>
                                        </ScrollPane>
                                        <Label fx:id="viewLblStatus" text="Trang thai" styleClass="field-label" />
                                        <Label fx:id="viewLblBidCount" text="0 luot" styleClass="section-caption" />
                                        <Label fx:id="viewLblCurrentPrice" text="0 d" styleClass="section-caption" />
                                    </children>
                                </VBox>

                                <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="viewLblName" text="Ten san pham" styleClass="page-title" wrapText="true" />
                                        <Label text="Gia khoi diem" styleClass="field-label" />
                                        <Label fx:id="viewLblPrice" text="0 d" styleClass="toolbar-balance" />
                                        <Label text="Ket thuc luc" styleClass="field-label" />
                                        <Label fx:id="viewLblEndTime" text="--" styleClass="section-caption" />
                                        <Label text="Mo ta" styleClass="field-label" />
                                        <Label fx:id="viewLblDesc" text="--" wrapText="true" styleClass="section-caption" />
                                        <HBox spacing="10.0">
                                            <children>
                                                <Button text="Chinh sua" onAction="#handleEditFromView" styleClass="btn-accent" />
                                                <Button text="Xoa san pham" onAction="#handleDeleteFromView" styleClass="btn-danger" />
                                            </children>
                                        </HBox>
                                        <Label fx:id="viewLblMsg" visible="false" wrapText="true" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>