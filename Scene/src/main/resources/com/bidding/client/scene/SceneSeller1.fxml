<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bidding.client.scene.SceneSeller1"
            prefWidth="1280.0"
            prefHeight="820.0"
            styleClass="dashboard-root"
            stylesheets="@theme.css">

    <children>

        <!-- ══════════════════ TOPBAR ══════════════════ -->
        <VBox styleClass="top-shell"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" styleClass="topbar" spacing="16.0"
                      style="-fx-padding: 12 24 12 24;">
                    <children>
                        <Button text="Trình đơn" onAction="#toggleMenu" styleClass="menu-toggle" />
                        <Label text="BidViet" styleClass="brand-title" />
                        <Label text="NGƯỜI BÁN" styleClass="role-badge" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnAvatar" onAction="#toggleAccountPopup"
                                style="-fx-background-radius:50em;-fx-min-width:42px;-fx-min-height:42px;
                                       -fx-max-width:42px;-fx-max-height:42px;-fx-background-color:#cbd5e1;
                                       -fx-cursor:hand;-fx-padding:0;">
                            <graphic>
                                <Label text="A" style="-fx-text-fill:#334155;-fx-font-weight:bold;-fx-font-size:16px;" />
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- ══════════════════ MAIN CONTENT ══════════════════ -->
        <VBox spacing="18.0"
              AnchorPane.topAnchor="80.0" AnchorPane.leftAnchor="24.0"
              AnchorPane.rightAnchor="24.0" AnchorPane.bottomAnchor="24.0">
            <children>

                <!-- Tiêu đề + bộ lọc + nút thêm -->
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label text="Sản phẩm của tôi" styleClass="page-title" />
                                <Label fx:id="lblProductCount" text="0 sản phẩm đang hiển thị"
                                       styleClass="page-subtitle" />
                                <Label fx:id="lblSellerNote" text="" styleClass="section-caption"
                                       wrapText="true" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Tất cả"          onAction="#filterAll"    styleClass="btn-secondary" />
                        <Button text="Đang đấu giá"    onAction="#filterActive" styleClass="btn-secondary" />
                        <Button text="Đã kết thúc"     onAction="#filterEnded"  styleClass="btn-secondary" />
                        <Button text="＋  Thêm sản phẩm" onAction="#showAddProductPopup"
                                styleClass="btn-accent"
                                style="-fx-font-size:14px; -fx-padding: 10 22;" />
                    </children>
                </HBox>

                <!-- Danh sách card sản phẩm -->
                <ScrollPane fitToWidth="true" styleClass="page-surface" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="productContainer" hgap="18.0" vgap="18.0"
                                  style="-fx-padding:12;" />
                    </content>
                </ScrollPane>
            </children>
        </VBox>

        <!-- ══════════════════ DIM OVERLAY ══════════════════ -->
        <AnchorPane fx:id="dimOverlay"
                    visible="false"
                    onMouseClicked="#closePopups"
                    style="-fx-background-color:rgba(15,23,42,0.36);"
                    AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" />

        <!-- ══════════════════ SIDE MENU ══════════════════ -->
        <AnchorPane fx:id="sideMenu"
                    prefWidth="300.0"
                    styleClass="drawer"
                    AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                    visible="false" managed="false">
            <children>
                <VBox spacing="0.0" prefWidth="300.0"
                      AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                      AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                    <children>
                        <VBox styleClass="drawer-header" spacing="6.0" style="-fx-padding:24 18 18 18;">
                            <children>
                                <Label text="BidViet" styleClass="drawer-title" />
                                <Label text="Giao diện người bán — đồng bộ màu sắc với người mua."
                                       styleClass="drawer-subtitle" wrapText="true" />
                            </children>
                        </VBox>
                        <VBox spacing="2.0" style="-fx-padding:14 0;">
                            <children>
                                <Button text="Sản phẩm của tôi"
                                        styleClass="drawer-button drawer-button-active" maxWidth="Infinity" />
                                <Button text="Thêm sản phẩm"
                                        onAction="#showAddProductPopup"
                                        styleClass="drawer-button" maxWidth="Infinity" />
                                <Button text="Quản lý đấu giá"
                                        onAction="#handleManageAuctions"
                                        styleClass="drawer-button" maxWidth="Infinity" />
                                <Button text="Thống kê doanh thu"
                                        onAction="#handleRevenueStats"
                                        styleClass="drawer-button" maxWidth="Infinity" />
                            </children>
                        </VBox>
                        <Region VBox.vgrow="ALWAYS" />
                        <Separator />
                        <VBox spacing="10.0" style="-fx-padding:18;">
                            <children>
                                <Button text="Chuyển sang người mua" onAction="#switchToBidder"
                                        styleClass="btn-secondary" maxWidth="Infinity" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </AnchorPane>

        <!-- ══════════════════ ACCOUNT POPUP ══════════════════ -->
        <AnchorPane fx:id="accountPopup"
                    prefWidth="280.0"
                    visible="false"
                    styleClass="popup-card"
                    AnchorPane.topAnchor="70.0" AnchorPane.rightAnchor="24.0">
            <children>
                <VBox spacing="14.0" alignment="TOP_CENTER"
                      AnchorPane.topAnchor="20.0" AnchorPane.rightAnchor="20.0"
                      AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0">
                    <children>
                        <Label text="Trần Văn A" styleClass="page-subtitle" />
                        <Label text="Tài khoản người bán" styleClass="field-label" />
                        <Button text="Cập nhật ảnh đại diện" onAction="#handleUploadAvatar"
                                styleClass="btn-secondary" maxWidth="Infinity"
                                style="-fx-font-size:12px;" />
                        <Separator />
                        <Label text="Doanh thu đang là dữ liệu giao diện."
                               styleClass="section-caption" wrapText="true" />
                        <Button text="Đăng xuất" onAction="#handleLogout"
                                styleClass="btn-danger" maxWidth="Infinity" />
                    </children>
                </VBox>
            </children>
        </AnchorPane>

        <!-- ══════════════════ VIEW PRODUCT POPUP ══════════════════ -->
        <AnchorPane fx:id="viewProductPopup"
                    prefWidth="840.0"
                    prefHeight="640.0"
                    visible="false"
                    styleClass="popup-card"
                    AnchorPane.topAnchor="92.0" AnchorPane.leftAnchor="220.0">
            <children>
                <VBox spacing="18.0"
                      AnchorPane.topAnchor="24.0" AnchorPane.rightAnchor="24.0"
                      AnchorPane.bottomAnchor="24.0" AnchorPane.leftAnchor="24.0">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Chi tiết sản phẩm" styleClass="page-title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="Đóng" onAction="#closeViewPopup" styleClass="btn-back" />
                            </children>
                        </HBox>

                        <HBox spacing="18.0" VBox.vgrow="ALWAYS">
                            <children>
                                <!-- Ảnh + trạng thái -->
                                <VBox spacing="12.0" prefWidth="300.0" styleClass="panel-soft">
                                    <padding>
                                        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
                                    </padding>
                                    <children>
                                        <ScrollPane fx:id="viewImageScroll" prefHeight="230.0"
                                                    hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                                                    fitToHeight="true">
                                            <content>
                                                <HBox fx:id="viewImageContainer" spacing="10.0">
                                                    <padding>
                                                        <Insets top="8.0" right="8.0" bottom="8.0" left="8.0" />
                                                    </padding>
                                                </HBox>
                                            </content>
                                        </ScrollPane>
                                        <Label fx:id="viewLblStatus" text="Trạng thái" styleClass="field-label" />
                                        <Label fx:id="viewLblBidCount" text="0 lượt" styleClass="section-caption" />
                                        <Label fx:id="viewLblCurrentPrice" text="0 đ" styleClass="section-caption" />
                                    </children>
                                </VBox>

                                <!-- Thông tin chi tiết -->
                                <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="viewLblName" text="Tên sản phẩm"
                                               styleClass="page-title" wrapText="true" />
                                        <Label text="Giá khởi điểm" styleClass="field-label" />
                                        <Label fx:id="viewLblPrice" text="0 đ" styleClass="toolbar-balance" />
                                        <Label text="Kết thúc lúc" styleClass="field-label" />
                                        <Label fx:id="viewLblEndTime" text="--" styleClass="section-caption" />
                                        <Label text="Mô tả" styleClass="field-label" />
                                        <Label fx:id="viewLblDesc" text="--" wrapText="true"
                                               styleClass="section-caption" />
                                        <HBox spacing="10.0">
                                            <children>
                                                <Button text="Chỉnh sửa"
                                                        onAction="#handleEditFromView"
                                                        styleClass="btn-accent" />
                                                <Button text="Mở phiên ngay"
                                                        onAction="#handleStartAuctionNow"
                                                        styleClass="btn-secondary" />
                                                <Button text="Xóa sản phẩm"
                                                        onAction="#handleDeleteFromView"
                                                        styleClass="btn-danger" />
                                            </children>
                                        </HBox>
                                        <Label fx:id="viewLblMsg" visible="false" wrapText="true" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </AnchorPane>

    </children>
</AnchorPane>
